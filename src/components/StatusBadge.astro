---
import type { ConsignmentStatus } from '../lib/types';

interface Props {
  status: ConsignmentStatus | string;
  size?: 'sm' | 'md' | 'lg';
  showIcon?: boolean;
}

const { status, size = 'md', showIcon = true } = Astro.props;

const statusConfigs: Record<string, { label: string; bg: string; text: string; border: string; dot: string }> = {
  delivered: {
    label: 'Delivered',
    bg: 'bg-emerald-500/10 dark:bg-emerald-500/15',
    text: 'text-emerald-700 dark:text-emerald-400',
    border: 'border-emerald-500/25',
    dot: 'bg-emerald-500',
  },
  out_for_delivery: {
    label: 'Out for Delivery',
    bg: 'bg-blue-500/10 dark:bg-blue-500/15',
    text: 'text-blue-700 dark:text-blue-400',
    border: 'border-blue-500/25',
    dot: 'bg-blue-500',
  },
  in_transit: {
    label: 'In Transit',
    bg: 'bg-amber-500/10 dark:bg-amber-500/15',
    text: 'text-amber-700 dark:text-amber-400',
    border: 'border-amber-500/25',
    dot: 'bg-amber-500',
  },
  dispatched: {
    label: 'Dispatched',
    bg: 'bg-indigo-500/10 dark:bg-indigo-500/15',
    text: 'text-indigo-700 dark:text-indigo-400',
    border: 'border-indigo-500/25',
    dot: 'bg-indigo-500',
  },
  booked: {
    label: 'Item Booked',
    bg: 'bg-zinc-500/10 dark:bg-zinc-500/15',
    text: 'text-zinc-700 dark:text-zinc-300',
    border: 'border-zinc-500/25',
    dot: 'bg-zinc-400',
  },
  exception: {
    label: 'Delivery Exception',
    bg: 'bg-red-500/10 dark:bg-red-500/15',
    text: 'text-red-700 dark:text-red-400',
    border: 'border-red-500/25',
    dot: 'bg-red-500',
  },
  rto: {
    label: 'Returned to Origin (RTO)',
    bg: 'bg-red-500/10 dark:bg-red-500/15',
    text: 'text-red-700 dark:text-red-400',
    border: 'border-red-500/25',
    dot: 'bg-red-500',
  },
};

const normalizedKey = status.toLowerCase();
const config = statusConfigs[normalizedKey] || {
  label: status,
  bg: 'bg-zinc-500/10 dark:bg-zinc-500/15',
  text: 'text-zinc-700 dark:text-zinc-300',
  border: 'border-zinc-500/25',
  dot: 'bg-zinc-400',
};

const sizeClasses = {
  sm: 'text-[11px] px-2 py-0.5 gap-1.5',
  md: 'text-xs font-semibold px-2.5 py-0.5 gap-1.5',
  lg: 'text-xs font-bold px-3 py-1 gap-2',
}[size];
---

<span
  class={`inline-flex items-center rounded-md border ${config.bg} ${config.text} ${config.border} ${sizeClasses} select-none transition-colors`}
>
  {showIcon && (
    <span class={`w-1.5 h-1.5 rounded-full ${config.dot}`} aria-hidden="true" />
  )}
  <span>{config.label}</span>
</span>
