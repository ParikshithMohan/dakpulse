---
import StatusBadge from './StatusBadge.astro';
import type { TrackingResult } from '../lib/types';

interface Props {
  data: TrackingResult;
}

const { data } = Astro.props;

// Determine step index (0 to 4)
const stepMap: Record<string, number> = {
  booked: 0,
  dispatched: 1,
  in_transit: 2,
  out_for_delivery: 3,
  delivered: 4,
  exception: 2,
  rto: 2,
};

const currentStepIndex = stepMap[data.currentStatus] ?? 1;
const isDelivered = data.currentStatus === 'delivered';
const isException = data.currentStatus === 'exception' || data.currentStatus === 'rto';

const steps = [
  { label: 'Booked', desc: data.bookedAt.split('(')[0] },
  { label: 'Dispatched', desc: 'Mail Sorting' },
  { label: 'In Transit', desc: isException ? 'Exception Encountered' : 'Inter-City Hub' },
  { label: 'Out for Delivery', desc: data.destinationOffice.split('(')[0] },
  { label: 'Delivered', desc: data.deliveredAt ? data.deliveredAt.split(' ')[0] : 'Pending' },
];
---

<div class="space-y-6">
  <!-- Milestone Progress Bar -->
  <div class="p-6 sm:p-8 rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] shadow-lg">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-3">
      <div>
        <span class="text-xs uppercase tracking-wider text-[var(--text-subtle)] font-bold">Consignment Number</span>
        <div class="flex items-center gap-3 mt-1.5">
          <h2 class="text-2xl sm:text-3xl font-black font-mono tracking-tight text-[var(--text-main)]">
            {data.consignmentNumber}
          </h2>
          <button
            type="button"
            id="copy-awb-btn"
            data-awb={data.consignmentNumber}
            class="px-2.5 py-1 rounded-lg text-xs font-semibold border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-muted)] hover:text-rose-500 hover:border-rose-500/30 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 flex items-center gap-1.5"
            title="Copy Consignment Number"
          >
            <span>📋</span> Copy
          </button>
        </div>
      </div>
      <div>
        <StatusBadge status={data.currentStatus} size="lg" />
      </div>
    </div>

    <!-- Step Progress Flow -->
    <div class="relative py-2">
      <!-- Progress Track Background -->
      <div class="hidden sm:block absolute top-6 left-6 right-6 h-1 bg-[var(--border)] rounded-full -z-0">
        <div
          class={`h-full rounded-full transition-all duration-700 ${
            isException
              ? 'bg-rose-500'
              : 'bg-gradient-to-r from-emerald-500 via-rose-500 to-emerald-500'
          }`}
          style={`width: ${(currentStepIndex / (steps.length - 1)) * 100}%`}
        ></div>
      </div>

      <!-- Step Nodes -->
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-4 relative z-10">
        {steps.map((step, idx) => {
          const isCompleted = isDelivered ? true : idx < currentStepIndex;
          const isCurrent = !isDelivered && idx === currentStepIndex;
          const isStepDelivered = isDelivered && idx === 4;

          const nodeBg = isStepDelivered
            ? 'bg-emerald-600 text-white ring-4 ring-emerald-500/30 scale-110 shadow-lg shadow-emerald-600/30'
            : isCurrent
            ? isException
              ? 'bg-rose-600 text-white ring-4 ring-rose-500/30 scale-110 shadow-lg shadow-rose-600/30'
              : 'bg-rose-600 text-white ring-4 ring-rose-500/30 scale-110 shadow-lg shadow-rose-600/30'
            : isCompleted
            ? 'bg-emerald-600 text-white'
            : 'bg-[var(--bg-page)] border-2 border-[var(--border)] text-[var(--text-subtle)]';

          const textColor = isStepDelivered
            ? 'text-emerald-500 font-extrabold'
            : isCurrent
            ? isException
              ? 'text-rose-500 font-extrabold'
              : 'text-rose-500 font-extrabold'
            : isCompleted
            ? 'text-[var(--text-main)] font-bold'
            : 'text-[var(--text-subtle)] font-medium';

          return (
            <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-2">
              <div
                class={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs shrink-0 transition-all ${nodeBg}`}
              >
                {isCompleted ? '✓' : isException && isCurrent ? '!' : idx + 1}
              </div>
              <div class="text-left sm:text-center">
                <p class={`text-xs leading-tight ${textColor}`}>
                  {step.label}
                </p>
                <p class="text-[11px] text-[var(--text-subtle)] mt-0.5 truncate max-w-[140px]">
                  {step.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Key Shipment Metadata Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] shadow-sm">
      <span class="text-[11px] font-semibold text-[var(--text-subtle)] uppercase block">Article Type</span>
      <strong class="text-xs sm:text-sm font-bold text-[var(--text-main)] mt-1 block truncate">
        {data.articleType}
      </strong>
    </div>
    <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] shadow-sm">
      <span class="text-[11px] font-semibold text-[var(--text-subtle)] uppercase block">Origin Post Office</span>
      <strong class="text-xs sm:text-sm font-bold text-[var(--text-main)] mt-1 block truncate">
        {data.bookedAt}
      </strong>
    </div>
    <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] shadow-sm">
      <span class="text-[11px] font-semibold text-[var(--text-subtle)] uppercase block">Destination Pincode</span>
      <strong class="text-xs sm:text-sm font-bold text-[var(--text-main)] mt-1 block truncate font-mono">
        {data.destinationPincode} ({data.destinationOffice.split('(')[0]})
      </strong>
    </div>
    <div class="p-4 sm:p-5 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] shadow-sm">
      <span class="text-[11px] font-semibold text-[var(--text-subtle)] uppercase block">Current Status</span>
      <strong class="text-xs sm:text-sm font-bold text-[var(--text-main)] mt-1 block truncate">
        {data.statusLabel}
      </strong>
    </div>
  </div>

  <!-- Detailed Event Audit Log -->
  <div class="p-6 sm:p-8 rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] shadow-lg">
    <div class="flex items-center justify-between pb-5 mb-5 border-b border-[var(--border)] flex-wrap gap-2">
      <div class="flex items-center gap-2.5">
        <h3 class="text-base font-bold text-[var(--text-main)]">Detailed Scan Log & Audit Trail</h3>
        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[var(--bg-page)] text-[var(--text-muted)] border border-[var(--border)]">
          {data.events.length} Postal Scans
        </span>
      </div>
      <button
        id="print-tracking-btn"
        type="button"
        class="px-3 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] flex items-center gap-1.5 transition-colors focus:outline-none"
      >
        <span>🖨️</span> Print Dispatch Slip
      </button>
    </div>

    <!-- Event Timeline List -->
    <div class="space-y-4">
      {data.events.map((ev, i) => (
        <div class="flex items-start gap-4 text-xs group">
          <!-- Time Column -->
          <div class="w-24 shrink-0 text-right">
            <span class="font-mono font-bold text-[var(--text-main)] block">{ev.date}</span>
            <span class="font-mono text-[11px] text-[var(--text-subtle)] block">{ev.time}</span>
          </div>

          <!-- Dot & Line -->
          <div class="relative flex flex-col items-center shrink-0 self-stretch">
            <div
              class={`w-3 h-3 rounded-full mt-1.5 ${
                i === 0
                  ? isDelivered
                    ? 'bg-emerald-500 ring-4 ring-emerald-500/20'
                    : 'bg-rose-500 ring-4 ring-rose-500/20'
                  : 'bg-[var(--border)] group-hover:bg-[var(--text-subtle)]'
              }`}
            ></div>
            {i !== data.events.length - 1 && (
              <div class="w-0.5 flex-1 bg-[var(--border)] my-1"></div>
            )}
          </div>

          <!-- Event Details -->
          <div class="flex-1 pb-3">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-sm text-[var(--text-main)]">{ev.event}</span>
              <StatusBadge status={ev.status} size="sm" showIcon={false} />
            </div>
            <p class="text-[var(--text-muted)] font-medium mt-0.5">{ev.office}</p>
            {ev.details && (
              <p class="text-[11px] text-[var(--text-subtle)] mt-1 font-mono bg-[var(--bg-page)]/80 px-2 py-1 rounded-lg border border-[var(--border)] inline-block">
                {ev.details}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  document.getElementById('copy-awb-btn')?.addEventListener('click', (e) => {
    const awb = e.currentTarget.getAttribute('data-awb');
    if (awb && navigator.clipboard) {
      navigator.clipboard.writeText(awb);
      if (window.showToast) window.showToast(`Copied ${awb} to clipboard`);
    }
  });

  document.getElementById('print-tracking-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>
