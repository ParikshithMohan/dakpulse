---
import StatusBadge from './StatusBadge.astro';
import type { TrackingResult } from '../lib/types';
import { buildSmartMilestones } from '../lib/audit-trail';

interface Props {
  data: TrackingResult;
}

const { data } = Astro.props;

// Determine step index (0 to 4)
const stepMap: Record<string, number> = {
  booked: 0,
  dispatched: 1,
  in_transit: 2,
  out_for_delivery: 3,
  delivered: 4,
  exception: 2,
  rto: 2,
};

const currentStepIndex = stepMap[data.currentStatus] ?? 1;
const isDelivered = data.currentStatus === 'delivered';
const isException = data.currentStatus === 'exception' || data.currentStatus === 'rto';

const steps = [
  { label: 'Booked', desc: data.bookedAt.split('(')[0] },
  { label: 'Dispatched', desc: 'Mail Sorting' },
  { label: 'In Transit', desc: isException ? 'Exception Encountered' : 'Inter-City RMS' },
  { label: 'Out for Delivery', desc: data.destinationOffice.split('(')[0] },
  { label: 'Delivered', desc: data.deliveredAt ? data.deliveredAt.split(' ')[0] : 'Pending' },
];

const smartMilestones = buildSmartMilestones(data.events);
---

<div class="space-y-6">
  <!-- Astryx Detail Header & Milestone Stepper -->
  <div class="astryx-card p-6">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3 pb-4 border-b border-[var(--border)]">
      <div>
        <span class="text-[11px] uppercase tracking-wider text-[var(--text-subtle)] font-bold">Consignment Identifier</span>
        <div class="flex items-center gap-3 mt-1">
          <h2 class="text-xl sm:text-2xl font-bold font-mono tracking-tight text-[var(--text-main)]">
            {data.consignmentNumber}
          </h2>
          <button
            type="button"
            id="copy-awb-btn"
            data-awb={data.consignmentNumber}
            class="px-2 py-0.5 rounded text-xs font-medium border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors focus:outline-none cursor-pointer"
            title="Copy Consignment Number"
          >
            Copy
          </button>
        </div>
      </div>
      <div>
        <StatusBadge status={data.currentStatus} size="lg" />
      </div>
    </div>

    <!-- Step Progress Flow -->
    <div class="relative py-2">
      <!-- Progress Track Background -->
      <div class="hidden sm:block absolute top-5 left-6 right-6 h-0.5 bg-[var(--border)] -z-0">
        <div
          class={`h-full transition-all duration-500 ${
            isException ? 'bg-red-500' : 'bg-red-600'
          }`}
          style={`width: ${(currentStepIndex / (steps.length - 1)) * 100}%`}
        ></div>
      </div>

      <!-- Step Nodes -->
      <div class="grid grid-cols-1 sm:grid-cols-5 gap-4 relative z-10">
        {steps.map((step, idx) => {
          const isCompleted = isDelivered ? true : idx < currentStepIndex;
          const isCurrent = !isDelivered && idx === currentStepIndex;
          const isStepDelivered = isDelivered && idx === 4;

          const nodeBg = isStepDelivered
            ? 'bg-emerald-600 text-white'
            : isCurrent
            ? isException
              ? 'bg-red-600 text-white ring-2 ring-red-500/30'
              : 'bg-red-600 text-white ring-2 ring-red-500/30'
            : isCompleted
            ? 'bg-emerald-600 text-white'
            : 'bg-[var(--bg-page)] border border-[var(--border)] text-[var(--text-subtle)]';

          const textColor = isStepDelivered
            ? 'text-emerald-500 font-bold'
            : isCurrent
            ? isException
              ? 'text-red-500 font-bold'
              : 'text-red-500 font-bold'
            : isCompleted
            ? 'text-[var(--text-main)] font-semibold'
            : 'text-[var(--text-subtle)] font-medium';

          return (
            <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-1.5">
              <div
                class={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shrink-0 transition-all ${nodeBg}`}
              >
                {isCompleted ? '✓' : isException && isCurrent ? '!' : idx + 1}
              </div>
              <div class="text-left sm:text-center">
                <p class={`text-xs leading-tight ${textColor}`}>
                  {step.label}
                </p>
                <p class="text-[11px] text-[var(--text-subtle)] mt-0.5 truncate max-w-[140px]">
                  {step.desc}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Key Shipment Metadata Data Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="p-3.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)]">
      <span class="text-[10px] font-semibold text-[var(--text-subtle)] uppercase block">Article Classification</span>
      <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate">
        {data.articleType}
      </strong>
    </div>
    <div class="p-3.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)]">
      <span class="text-[10px] font-semibold text-[var(--text-subtle)] uppercase block">Booking Office</span>
      <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate">
        {data.bookedAt}
      </strong>
    </div>
    <div class="p-3.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)]">
      <span class="text-[10px] font-semibold text-[var(--text-subtle)] uppercase block">Destination Office</span>
      <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate font-mono">
        {data.destinationPincode} ({data.destinationOffice.split('(')[0]})
      </strong>
    </div>
    <div class="p-3.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)]">
      <span class="text-[10px] font-semibold text-[var(--text-subtle)] uppercase block">Current State</span>
      <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate">
        {data.statusLabel}
      </strong>
    </div>
  </div>

  <!-- Smart Compact Audit Trail -->
  <div class="astryx-card p-6">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-[var(--border)] flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-main)]">Transit Milestones</h3>
        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          Smart View ({smartMilestones.length} Hubs)
        </span>
      </div>
      <button
        id="print-tracking-btn"
        type="button"
        class="px-2.5 py-1 rounded border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] flex items-center gap-1.5 transition-colors focus:outline-none cursor-pointer"
      >
        <span>Print Dispatch Slip</span>
      </button>
    </div>

    <!-- Compact Key Milestones -->
    <div class="space-y-4">
      {smartMilestones.map((m, i) => (
        <div class="flex items-start gap-3.5 text-xs group">
          <!-- Time Column -->
          <div class="w-24 shrink-0 text-right">
            <span class="font-mono font-semibold text-[var(--text-main)] block">{m.date}</span>
            <span class="font-mono text-[10px] text-[var(--text-subtle)] block">{m.time}</span>
          </div>

          <!-- Dot & Line -->
          <div class="relative flex flex-col items-center shrink-0 self-stretch">
            <div
              class={`w-2.5 h-2.5 rounded-full mt-1.5 ${
                m.isLatest
                  ? isDelivered
                    ? 'bg-emerald-500 ring-2 ring-emerald-500/30'
                    : 'bg-red-500 ring-2 ring-red-500/30'
                  : 'bg-[var(--border-subtle)]'
              }`}
            ></div>
            {i !== smartMilestones.length - 1 && (
              <div class="w-px flex-1 bg-[var(--border)] my-1"></div>
            )}
          </div>

          <!-- Milestone Details -->
          <div class="flex-1 pb-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-sm text-[var(--text-main)]">{m.title}</span>
              <span class={`px-2 py-0.5 rounded text-[10px] font-medium border ${m.badgeClass}`}>
                {m.badgeLabel}
              </span>
              {m.scansCount > 1 && (
                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-[var(--bg-page)] text-[var(--text-subtle)] border border-[var(--border)]">
                  {m.scansCount} internal scans
                </span>
              )}
            </div>
            <p class="text-[var(--text-muted)] text-xs mt-1 font-medium">{m.office}</p>
            {m.details && (
              <p class="text-[11px] text-[var(--text-subtle)] mt-1">
                {m.details}
              </p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Toggle Full Raw Scan Log Accordion Button -->
    <div class="mt-6 pt-4 border-t border-[var(--border)] flex items-center justify-between">
      <button
        id="toggle-raw-scans-btn"
        type="button"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-500 hover:text-red-400 focus:outline-none cursor-pointer transition-colors"
      >
        <span id="raw-btn-label">Show Complete Scan Log ({data.events.length} Scans)</span>
        <span id="raw-btn-arrow" class="transition-transform duration-200">▾</span>
      </button>
      <span class="text-[11px] text-[var(--text-subtle)] font-mono">Raw India Post RMS Logs</span>
    </div>

    <!-- Collapsible Full Raw Scans Container -->
    <div id="raw-scans-container" class="hidden mt-4 pt-4 border-t border-[var(--border)] space-y-3">
      {data.events.map((ev, i) => (
        <div class="flex items-start gap-3.5 text-xs py-1 border-b border-[var(--border)]/40 last:border-none">
          <div class="w-24 shrink-0 text-right">
            <span class="font-mono text-xs text-[var(--text-muted)] block">{ev.date}</span>
            <span class="font-mono text-[10px] text-[var(--text-subtle)] block">{ev.time}</span>
          </div>
          <div class="flex-1">
            <div class="flex items-center gap-2">
              <span class="font-mono font-semibold text-xs text-[var(--text-main)]">{ev.event}</span>
              <span class="text-[10px] font-mono text-[var(--text-subtle)] bg-[var(--bg-page)] px-1.5 py-0.5 rounded border border-[var(--border)]">
                {ev.office}
              </span>
            </div>
            {ev.details && (
              <p class="text-[11px] text-[var(--text-subtle)] mt-0.5 font-mono">{ev.details}</p>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  document.getElementById('copy-awb-btn')?.addEventListener('click', (e) => {
    const awb = e.currentTarget.getAttribute('data-awb');
    if (awb && navigator.clipboard) {
      navigator.clipboard.writeText(awb);
      if (window.showToast) window.showToast(`Copied ${awb}`);
    }
  });

  document.getElementById('print-tracking-btn')?.addEventListener('click', () => {
    window.print();
  });

  // Toggle raw audit trail accordion
  const toggleBtn = document.getElementById('toggle-raw-scans-btn');
  const rawContainer = document.getElementById('raw-scans-container');
  const rawLabel = document.getElementById('raw-btn-label');
  const rawArrow = document.getElementById('raw-btn-arrow');

  toggleBtn?.addEventListener('click', () => {
    if (!rawContainer) return;
    const isHidden = rawContainer.classList.contains('hidden');
    if (isHidden) {
      rawContainer.classList.remove('hidden');
      if (rawLabel) rawLabel.textContent = 'Hide Complete Scan Log';
      if (rawArrow) rawArrow.textContent = '▴';
    } else {
      rawContainer.classList.add('hidden');
      if (rawLabel) rawLabel.textContent = 'Show Complete Scan Log';
      if (rawArrow) rawArrow.textContent = '▾';
    }
  });
</script>
