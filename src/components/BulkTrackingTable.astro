---
// Bulk Tracking Interactive Component
---

<div class="space-y-6">
  <!-- Precision Input Card -->
  <div class="rounded-xl border border-zinc-800 bg-[#0d0e12] p-6 sm:p-8 shadow-xl crosshair-corner">
    <div class="max-w-3xl space-y-3">
      <div class="flex items-center gap-2 border-b border-zinc-800 pb-2.5">
        <span class="w-2 h-2 rounded-full bg-red-500"></span>
        <span class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-400">
          Batch Consignment Audit
        </span>
        <span class="text-[11px] font-mono text-zinc-500 ml-auto">Max 50 / Batch</span>
      </div>

      <div class="space-y-1 pt-1">
        <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-white font-heading">
          Bulk Consignment Audit
        </h1>
        <p class="text-xs text-zinc-400">
          Batch query multiple India Post tracking numbers. Import CSV manifests or paste consignment lists for automated status audits.
        </p>
      </div>

      <!-- Input Form -->
      <form id="bulk-tracking-form" class="mt-4 space-y-4">
        <div>
          <label for="bulk-awb-input" class="block text-[11px] font-bold text-[var(--text-subtle)] mb-1.5 uppercase tracking-wider">
            Consignment Numbers (One per line or comma-separated)
          </label>
          <textarea
            id="bulk-awb-input"
            name="consignments"
            rows="5"
            placeholder="Paste consignment IDs here, e.g.&#10;ED451209384IN&#10;CX137150258IN&#10;EK982143051IN"
            class="w-full p-3.5 rounded-md border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-main)] placeholder-[var(--text-subtle)] text-xs font-mono font-medium focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-all shadow-xs leading-relaxed resize-y"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <div class="flex items-center gap-2">
            <!-- CSV Upload Drop trigger -->
            <label class="px-3 py-1.5 rounded-md border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors cursor-pointer focus-within:ring-2 focus-within:ring-red-500">
              <span>Import Manifest (CSV / TXT)</span>
              <input type="file" id="bulk-file-input" accept=".csv,.txt" class="sr-only" />
            </label>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="clear-bulk-btn"
              type="button"
              class="px-3 py-1.5 rounded-md text-xs font-medium text-[var(--text-subtle)] hover:text-[var(--text-muted)] transition-colors cursor-pointer"
            >
              Clear
            </button>
            <button
              id="submit-bulk-btn"
              type="submit"
              class="px-5 py-2 rounded-md bg-red-600 hover:bg-red-500 text-white font-semibold text-xs tracking-wide shadow-xs transition-colors flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-red-500 cursor-pointer"
            >
              <span id="bulk-btn-text">Audit Batch</span>
              <span id="bulk-btn-spinner" class="hidden w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Results Section -->
  <div id="bulk-results-section" class="hidden space-y-5">
    <!-- Metric KPI Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
      <div class="p-3.5 rounded-md border border-[var(--border)] bg-[var(--bg-card)]">
        <span class="text-[10px] font-semibold text-[var(--text-subtle)] uppercase">Total Audited</span>
        <div id="metric-total" class="text-xl font-bold font-mono text-[var(--text-main)] mt-0.5">0</div>
      </div>
      <div class="p-3.5 rounded-md border border-emerald-500/20 bg-emerald-500/5">
        <span class="text-[10px] font-semibold text-emerald-500 uppercase">Delivered</span>
        <div id="metric-delivered" class="text-xl font-bold font-mono text-emerald-500 mt-0.5">0</div>
      </div>
      <div class="p-3.5 rounded-md border border-amber-500/20 bg-amber-500/5">
        <span class="text-[10px] font-semibold text-amber-500 uppercase">In Transit</span>
        <div id="metric-intransit" class="text-xl font-bold font-mono text-amber-500 mt-0.5">0</div>
      </div>
      <div class="p-3.5 rounded-md border border-blue-500/20 bg-blue-500/5">
        <span class="text-[10px] font-semibold text-blue-500 uppercase">Out for Delivery</span>
        <div id="metric-outfordelivery" class="text-xl font-bold font-mono text-blue-500 mt-0.5">0</div>
      </div>
      <div class="p-3.5 rounded-md border border-red-500/20 bg-red-500/5 col-span-2 sm:col-span-1">
        <span class="text-[10px] font-semibold text-red-500 uppercase">Exceptions / RTO</span>
        <div id="metric-exceptions" class="text-xl font-bold font-mono text-red-500 mt-0.5">0</div>
      </div>
    </div>

    <!-- Filter Bar & Table Controls -->
    <div class="astryx-card overflow-hidden">
      <div class="p-4 border-b border-[var(--border)] flex flex-wrap items-center justify-between gap-3 bg-[var(--bg-card)]">
        <!-- Filter Tabs -->
        <div class="flex items-center gap-1 bg-[var(--bg-page)] p-1 rounded-md border border-[var(--border)]" id="status-filters">
          <button
            type="button"
            data-filter="all"
            class="filter-tab px-2.5 py-1 rounded text-xs font-semibold bg-red-600 text-white transition-all cursor-pointer"
          >
            All (<span id="tab-count-all">0</span>)
          </button>
          <button
            type="button"
            data-filter="delivered"
            class="filter-tab px-2.5 py-1 rounded text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-all cursor-pointer"
          >
            Delivered (<span id="tab-count-delivered">0</span>)
          </button>
          <button
            type="button"
            data-filter="in_transit"
            class="filter-tab px-2.5 py-1 rounded text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-all cursor-pointer"
          >
            In Transit (<span id="tab-count-intransit">0</span>)
          </button>
          <button
            type="button"
            data-filter="out_for_delivery"
            class="filter-tab px-2.5 py-1 rounded text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-all cursor-pointer"
          >
            Out for Delivery (<span id="tab-count-outfordelivery">0</span>)
          </button>
          <button
            type="button"
            data-filter="exception"
            class="filter-tab px-2.5 py-1 rounded text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-all cursor-pointer"
          >
            Exceptions (<span id="tab-count-exceptions">0</span>)
          </button>
        </div>

        <!-- Export Actions -->
        <div class="flex items-center gap-2">
          <button
            id="export-csv-btn"
            type="button"
            class="px-2.5 py-1 rounded border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-main)] flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            Export CSV
          </button>
          <button
            id="export-json-btn"
            type="button"
            class="px-2.5 py-1 rounded border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            JSON
          </button>
        </div>
      </div>

      <!-- Table -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-[var(--bg-page)] text-[var(--text-subtle)] uppercase text-[10px] font-bold tracking-wider border-b border-[var(--border)]">
            <tr>
              <th scope="col" class="p-3.5 pl-4">Consignment ID</th>
              <th scope="col" class="p-3.5">Status</th>
              <th scope="col" class="p-3.5">Origin ➔ Destination</th>
              <th scope="col" class="p-3.5">Latest Scan Event</th>
              <th scope="col" class="p-3.5 pr-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="bulk-table-body" class="divide-y divide-[var(--border)]">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import type { TrackingResult } from '../lib/types';

  const form = document.getElementById('bulk-tracking-form') as HTMLFormElement | null;
  const textarea = document.getElementById('bulk-awb-input') as HTMLTextAreaElement | null;
  const fileInput = document.getElementById('bulk-file-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-bulk-btn');
  const submitBtn = document.getElementById('submit-bulk-btn');
  const btnText = document.getElementById('bulk-btn-text');
  const btnSpinner = document.getElementById('bulk-btn-spinner');
  const resultsSection = document.getElementById('bulk-results-section');
  const tableBody = document.getElementById('bulk-table-body');

  const metricTotal = document.getElementById('metric-total');
  const metricDelivered = document.getElementById('metric-delivered');
  const metricInTransit = document.getElementById('metric-intransit');
  const metricOutForDelivery = document.getElementById('metric-outfordelivery');
  const metricExceptions = document.getElementById('metric-exceptions');

  const tabCountAll = document.getElementById('tab-count-all');
  const tabCountDelivered = document.getElementById('tab-count-delivered');
  const tabCountInTransit = document.getElementById('tab-count-intransit');
  const tabCountOutForDelivery = document.getElementById('tab-count-outfordelivery');
  const tabCountExceptions = document.getElementById('tab-count-exceptions');

  let currentResults: TrackingResult[] = [];
  let currentFilter = 'all';

  clearBtn?.addEventListener('click', () => {
    if (textarea) textarea.value = '';
    if (resultsSection) resultsSection.classList.add('hidden');
    currentResults = [];
  });

  // CSV File Upload
  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const text = event.target?.result as string;
      if (!text || !textarea) return;

      const lines = text
        .split(/[\r\n,]+/)
        .map((x) => x.trim().toUpperCase().replace(/["']/g, ''))
        .filter((x) => /^[A-Z]{2}\d{9}[A-Z]{2}$/.test(x));

      const unique = Array.from(new Set(lines)).slice(0, 50);
      textarea.value = unique.join('\n');

      if ((window as unknown as { showToast?: (m: string) => void }).showToast) {
        (window as unknown as { showToast: (m: string) => void }).showToast(
          `Imported ${unique.length} consignment IDs from file`
        );
      }
    };
    reader.readAsText(file);
  });

  // Form Submit
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!textarea) return;

    const raw = textarea.value;
    const lines = raw
      .split(/[\r\n,]+/)
      .map((x) => x.trim().toUpperCase().replace(/[\s-]/g, ''))
      .filter((x) => x.length > 0);

    const consignments = Array.from(new Set(lines)).slice(0, 50);

    if (consignments.length === 0) {
      if ((window as unknown as { showToast?: (m: string, t?: string) => void }).showToast) {
        (window as unknown as { showToast: (m: string, t?: string) => void }).showToast(
          'Please enter at least one consignment number',
          'error'
        );
      }
      return;
    }

    if (btnText) btnText.textContent = `Auditing (${consignments.length})…`;
    if (btnSpinner) btnSpinner.classList.remove('hidden');
    if (submitBtn) submitBtn.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ consignments }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to audit consignment batch');
      }

      currentResults = data.results || [];
      renderMetrics(data.metrics);
      renderTable();

      if (resultsSection) {
        resultsSection.classList.remove('hidden');
        resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } catch (err) {
      if ((window as unknown as { showToast?: (m: string, t?: string) => void }).showToast) {
        (window as unknown as { showToast: (m: string, t?: string) => void }).showToast(
          (err as Error).message || 'Batch audit failed',
          'error'
        );
      }
    } finally {
      if (btnText) btnText.textContent = 'Audit Batch';
      if (btnSpinner) btnSpinner.classList.add('hidden');
      if (submitBtn) submitBtn.removeAttribute('disabled');
    }
  });

  function renderMetrics(metrics: {
    total: number;
    delivered: number;
    inTransit: number;
    outForDelivery: number;
    exceptions: number;
  }) {
    if (metricTotal) metricTotal.textContent = String(metrics.total);
    if (metricDelivered) metricDelivered.textContent = String(metrics.delivered);
    if (metricInTransit) metricInTransit.textContent = String(metrics.inTransit);
    if (metricOutForDelivery) metricOutForDelivery.textContent = String(metrics.outForDelivery);
    if (metricExceptions) metricExceptions.textContent = String(metrics.exceptions);

    if (tabCountAll) tabCountAll.textContent = String(metrics.total);
    if (tabCountDelivered) tabCountDelivered.textContent = String(metrics.delivered);
    if (tabCountInTransit) tabCountInTransit.textContent = String(metrics.inTransit);
    if (tabCountOutForDelivery) tabCountOutForDelivery.textContent = String(metrics.outForDelivery);
    if (tabCountExceptions) tabCountExceptions.textContent = String(metrics.exceptions);
  }

  function renderTable() {
    if (!tableBody) return;

    let filtered = currentResults;
    if (currentFilter !== 'all') {
      filtered = currentResults.filter((r) => {
        if (currentFilter === 'exception') {
          return r.currentStatus === 'exception' || r.currentStatus === 'rto';
        }
        return r.currentStatus === currentFilter;
      });
    }

    if (filtered.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="5" class="p-8 text-center text-[var(--text-subtle)]">
            No consignments match the selected filter.
          </td>
        </tr>
      `;
      return;
    }

    tableBody.innerHTML = filtered
      .map((r) => {
        const statusBadgeClass =
          r.currentStatus === 'delivered'
            ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/25'
            : r.currentStatus === 'out_for_delivery'
            ? 'bg-blue-500/10 text-blue-500 border-blue-500/25'
            : r.currentStatus === 'exception'
            ? 'bg-red-500/10 text-red-500 border-red-500/25'
            : 'bg-amber-500/10 text-amber-500 border-amber-500/25';

        const lastEv = r.events[0];

        return `
          <tr class="hover:bg-[var(--bg-card-hover)] transition-colors">
            <td class="p-3 pl-4 font-mono font-bold text-[var(--text-main)]">
              <div class="flex items-center gap-2">
                <span>${r.consignmentNumber}</span>
                <button type="button" class="copy-cell-btn text-[10px] text-[var(--text-subtle)] hover:text-red-500 cursor-pointer" data-awb="${r.consignmentNumber}" title="Copy AWB">
                  Copy
                </button>
              </div>
            </td>
            <td class="p-3">
              <span class="inline-flex items-center rounded border px-2 py-0.5 text-[11px] font-semibold gap-1.5 ${statusBadgeClass}">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <span>${r.statusLabel}</span>
              </span>
            </td>
            <td class="p-3 text-[var(--text-muted)] text-[11px]">
              <span class="truncate block max-w-[200px]">${r.bookedAt.split('(')[0]} ➔ ${r.destinationOffice.split('(')[0]}</span>
            </td>
            <td class="p-3">
              <span class="font-medium text-[var(--text-main)] block">${lastEv?.event ?? 'Dispatched'}</span>
              <span class="text-[10px] text-[var(--text-subtle)] font-mono block">${lastEv?.date ?? ''} ${lastEv?.time ?? ''}</span>
            </td>
            <td class="p-3 pr-4 text-right">
              <a
                href="/?consignment=${encodeURIComponent(r.consignmentNumber)}"
                class="px-2.5 py-1 rounded text-xs font-medium border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-muted)] hover:text-red-500 hover:border-red-500/30 transition-colors inline-block"
              >
                Track Map ➔
              </a>
            </td>
          </tr>
        `;
      })
      .join('');

    tableBody.querySelectorAll('.copy-cell-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const awb = btn.getAttribute('data-awb');
        if (awb && navigator.clipboard) {
          navigator.clipboard.writeText(awb);
          if ((window as unknown as { showToast?: (m: string) => void }).showToast) {
            (window as unknown as { showToast: (m: string) => void }).showToast(`Copied ${awb}`);
          }
        }
      });
    });
  }

  // Filter Tabs
  document.querySelectorAll('.filter-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.filter-tab').forEach((t) => {
        t.classList.remove('bg-red-600', 'text-white', 'font-semibold');
        t.classList.add('text-[var(--text-muted)]', 'font-medium');
      });
      tab.classList.add('bg-red-600', 'text-white', 'font-semibold');
      tab.classList.remove('text-[var(--text-muted)]', 'font-medium');

      currentFilter = tab.getAttribute('data-filter') || 'all';
      renderTable();
    });
  });

  // Export CSV
  document.getElementById('export-csv-btn')?.addEventListener('click', () => {
    if (currentResults.length === 0) return;

    const headers = ['Consignment Number', 'Status', 'Booked At', 'Destination Pincode', 'Delivered At', 'Latest Event', 'Latest Date'];
    const rows = currentResults.map((r) => [
      `"${r.consignmentNumber}"`,
      `"${r.currentStatus}"`,
      `"${r.bookedAt}"`,
      `"${r.destinationPincode}"`,
      `"${r.deliveredAt || ''}"`,
      `"${r.events[0]?.event || ''}"`,
      `"${r.events[0]?.date || ''} ${r.events[0]?.time || ''}"`,
    ]);

    const csvContent = [headers.join(','), ...rows.map((row) => row.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `dakpulse-audit-${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Export JSON
  document.getElementById('export-json-btn')?.addEventListener('click', () => {
    if (currentResults.length === 0) return;
    const blob = new Blob([JSON.stringify(currentResults, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `dakpulse-audit-${new Date().toISOString().slice(0, 10)}.json`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });
</script>
