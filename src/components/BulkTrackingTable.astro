---
// Bulk Tracking Interactive Component
---

<div class="space-y-8">
  <!-- Input Card -->
  <div class="p-6 sm:p-8 rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] shadow-xl">
    <div class="max-w-3xl">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-500 border border-rose-500/20">
          Batch Dispatch Engine
        </span>
        <span class="text-xs text-[var(--text-subtle)]">Up to 50 consignments per batch</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-[var(--text-main)]">
        Bulk India Post Consignment Tracking
      </h2>
      <p class="text-xs sm:text-sm text-[var(--text-muted)] mt-1">
        Paste multiple consignment numbers (one per line or comma-separated) or drop a dispatch CSV list to audit order statuses in bulk.
      </p>

      <!-- Input Form -->
      <form id="bulk-tracking-form" class="mt-6 space-y-4">
        <div>
          <label for="bulk-awb-input" class="block text-xs font-semibold text-[var(--text-muted)] mb-1.5 uppercase tracking-wider">
            Consignment Numbers
          </label>
          <textarea
            id="bulk-awb-input"
            name="consignments"
            rows="5"
            placeholder="Paste consignment numbers here, for example:&#10;CX137150258IN&#10;EK982143051IN&#10;ED451209384IN&#10;EU781920394IN"
            class="w-full p-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-main)] placeholder-[var(--text-subtle)] text-xs font-mono font-medium focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all shadow-inner leading-relaxed resize-y"
          ></textarea>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <div class="flex items-center gap-2">
            <!-- Sample Batch Button -->
            <button
              id="load-demo-batch-btn"
              type="button"
              class="px-3 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors focus:outline-none"
            >
              ⚡ Load Sample Batch
            </button>

            <!-- CSV Upload Drop trigger -->
            <label class="px-3 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors cursor-pointer focus-within:ring-2 focus-within:ring-rose-500">
              📁 Import CSV / TXT
              <input type="file" id="bulk-file-input" accept=".csv,.txt" class="sr-only" />
            </label>
          </div>

          <div class="flex items-center gap-2">
            <button
              id="clear-bulk-btn"
              type="button"
              class="px-4 py-2 rounded-xl text-xs font-medium text-[var(--text-subtle)] hover:text-[var(--text-muted)] transition-colors"
            >
              Clear
            </button>
            <button
              id="submit-bulk-btn"
              type="submit"
              class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-500 hover:to-red-400 text-white font-bold text-xs tracking-wide shadow-md shadow-rose-600/20 transition-all flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-rose-500 cursor-pointer"
            >
              <span id="bulk-btn-text">Audit Batch</span>
              <span id="bulk-btn-spinner" class="hidden w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Results Section -->
  <div id="bulk-results-section" class="hidden space-y-6">
    <!-- Metric KPI Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
      <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]">
        <span class="text-[11px] font-semibold text-[var(--text-subtle)] uppercase">Total Audited</span>
        <div id="metric-total" class="text-2xl font-black text-[var(--text-main)] mt-1">0</div>
      </div>
      <div class="p-4 rounded-2xl border border-emerald-500/20 bg-emerald-500/5">
        <span class="text-[11px] font-semibold text-emerald-500 uppercase">Delivered</span>
        <div id="metric-delivered" class="text-2xl font-black text-emerald-500 mt-1">0</div>
      </div>
      <div class="p-4 rounded-2xl border border-amber-500/20 bg-amber-500/5">
        <span class="text-[11px] font-semibold text-amber-500 uppercase">In Transit</span>
        <div id="metric-intransit" class="text-2xl font-black text-amber-500 mt-1">0</div>
      </div>
      <div class="p-4 rounded-2xl border border-blue-500/20 bg-blue-500/5">
        <span class="text-[11px] font-semibold text-blue-500 uppercase">Out for Delivery</span>
        <div id="metric-outfordelivery" class="text-2xl font-black text-blue-500 mt-1">0</div>
      </div>
      <div class="p-4 rounded-2xl border border-rose-500/20 bg-rose-500/5 col-span-2 sm:col-span-1">
        <span class="text-[11px] font-semibold text-rose-500 uppercase">Exceptions / RTO</span>
        <div id="metric-exceptions" class="text-2xl font-black text-rose-500 mt-1">0</div>
      </div>
    </div>

    <!-- Filter & Export Toolbar -->
    <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0" id="filter-tabs">
        <button type="button" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 text-white transition-colors" data-filter="all">
          All (<span id="tab-count-all">0</span>)
        </button>
        <button type="button" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors" data-filter="delivered">
          Delivered (<span id="tab-count-delivered">0</span>)
        </button>
        <button type="button" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors" data-filter="in_transit">
          In Transit (<span id="tab-count-intransit">0</span>)
        </button>
        <button type="button" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors" data-filter="out_for_delivery">
          Out for Delivery (<span id="tab-count-outfordelivery">0</span>)
        </button>
        <button type="button" class="filter-tab px-3 py-1.5 rounded-lg text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors" data-filter="exception">
          Exceptions (<span id="tab-count-exceptions">0</span>)
        </button>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="export-csv-btn"
          type="button"
          class="px-3 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-main)] flex items-center gap-1.5 transition-colors focus:outline-none"
        >
          <span>📥</span> Export CSV
        </button>
        <button
          id="export-json-btn"
          type="button"
          class="px-3 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-page)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-main)] flex items-center gap-1.5 transition-colors focus:outline-none"
        >
          <span>JSON</span> Export
        </button>
      </div>
    </div>

    <!-- Batch Table -->
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-[var(--border)] bg-[var(--bg-page)]/60 text-[var(--text-subtle)] font-semibold uppercase tracking-wider">
              <th class="p-3.5 pl-4">Consignment</th>
              <th class="p-3.5">Status</th>
              <th class="p-3.5">Route</th>
              <th class="p-3.5">Latest Event</th>
              <th class="p-3.5 pr-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="bulk-table-body" class="divide-y divide-[var(--border)]">
            <!-- Populated via script -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  import type { BulkTrackingSummary, TrackingResult } from '../lib/types';

  const form = document.getElementById('bulk-tracking-form') as HTMLFormElement | null;
  const textarea = document.getElementById('bulk-awb-input') as HTMLTextAreaElement | null;
  const fileInput = document.getElementById('bulk-file-input') as HTMLInputElement | null;
  const loadDemoBtn = document.getElementById('load-demo-batch-btn');
  const clearBtn = document.getElementById('clear-bulk-btn');
  const submitBtn = document.getElementById('submit-bulk-btn');
  const btnText = document.getElementById('bulk-btn-text');
  const btnSpinner = document.getElementById('bulk-btn-spinner');
  const resultsSection = document.getElementById('bulk-results-section');
  const tableBody = document.getElementById('bulk-table-body');

  const metricTotal = document.getElementById('metric-total');
  const metricDelivered = document.getElementById('metric-delivered');
  const metricInTransit = document.getElementById('metric-intransit');
  const metricOutForDelivery = document.getElementById('metric-outfordelivery');
  const metricExceptions = document.getElementById('metric-exceptions');

  const tabCountAll = document.getElementById('tab-count-all');
  const tabCountDelivered = document.getElementById('tab-count-delivered');
  const tabCountInTransit = document.getElementById('tab-count-intransit');
  const tabCountOutForDelivery = document.getElementById('tab-count-outfordelivery');
  const tabCountExceptions = document.getElementById('tab-count-exceptions');

  let currentResults: TrackingResult[] = [];
  let currentFilter = 'all';

  // Demo Batch
  loadDemoBtn?.addEventListener('click', () => {
    if (textarea) {
      textarea.value = [
        'CX137150258IN',
        'EK982143051IN',
        'ED451209384IN',
        'EU781920394IN',
        'EM998877665IN',
        'EK123456789IN',
      ].join('\n');
    }
  });

  clearBtn?.addEventListener('click', () => {
    if (textarea) textarea.value = '';
    if (resultsSection) resultsSection.classList.add('hidden');
    currentResults = [];
  });

  // CSV File Upload
  fileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const content = String(event.target?.result || '');
      // Extract matches for India Post AWB pattern
      const matches = content.match(/[A-Za-z]{2}\d{9}[A-Za-z]{2}/g);
      if (matches && matches.length > 0 && textarea) {
        textarea.value = Array.from(new Set(matches.map((s) => s.toUpperCase()))).join('\n');
        if ((window as unknown as { showToast?: (m: string) => void }).showToast) {
          (window as unknown as { showToast: (m: string) => void }).showToast(`Loaded ${matches.length} consignments from file`);
        }
      }
    };
    reader.readAsText(file);
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!textarea) return;

    const raw = textarea.value;
    const lines = raw
      .split(/[\n,;]+/)
      .map((s) => s.trim().toUpperCase().replace(/[\s-]/g, ''))
      .filter((s) => /^[A-Z]{2}[0-9]{9}[A-Z]{2}$/.test(s));

    if (lines.length === 0) {
      alert('Please enter at least one valid 13-character Indian Post consignment number.');
      return;
    }

    if (btnText) btnText.textContent = 'Auditing…';
    if (btnSpinner) btnSpinner.classList.remove('hidden');

    try {
      const res = await fetch('/api/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ consignments: lines }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to process bulk request');
      }

      const summary = data.summary as BulkTrackingSummary;
      currentResults = summary.results;

      // Update KPI metrics
      if (metricTotal) metricTotal.textContent = String(summary.total);
      if (metricDelivered) metricDelivered.textContent = String(summary.delivered);
      if (metricInTransit) metricInTransit.textContent = String(summary.inTransit);
      if (metricOutForDelivery) metricOutForDelivery.textContent = String(summary.outForDelivery);
      if (metricExceptions) metricExceptions.textContent = String(summary.exceptions);

      // Update Tab Counts
      if (tabCountAll) tabCountAll.textContent = String(summary.total);
      if (tabCountDelivered) tabCountDelivered.textContent = String(summary.delivered);
      if (tabCountInTransit) tabCountInTransit.textContent = String(summary.inTransit);
      if (tabCountOutForDelivery) tabCountOutForDelivery.textContent = String(summary.outForDelivery);
      if (tabCountExceptions) tabCountExceptions.textContent = String(summary.exceptions);

      renderTable();
      if (resultsSection) resultsSection.classList.remove('hidden');
    } catch (err) {
      alert((err as Error).message);
    } finally {
      if (btnText) btnText.textContent = 'Audit Batch';
      if (btnSpinner) btnSpinner.classList.add('hidden');
    }
  });

  function renderTable() {
    if (!tableBody) return;

    const filtered = currentResults.filter((r) => {
      if (currentFilter === 'all') return true;
      if (currentFilter === 'delivered') return r.currentStatus === 'delivered';
      if (currentFilter === 'in_transit') return r.currentStatus === 'in_transit' || r.currentStatus === 'dispatched';
      if (currentFilter === 'out_for_delivery') return r.currentStatus === 'out_for_delivery';
      if (currentFilter === 'exception') return r.currentStatus === 'exception' || r.currentStatus === 'rto';
      return true;
    });

    if (filtered.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="5" class="p-8 text-center text-[var(--text-subtle)]">
            No consignments match the selected filter.
          </td>
        </tr>
      `;
      return;
    }

    tableBody.innerHTML = filtered
      .map((r) => {
        const statusBadgeClass =
          r.currentStatus === 'delivered'
            ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/25'
            : r.currentStatus === 'out_for_delivery'
            ? 'bg-blue-500/10 text-blue-500 border-blue-500/25'
            : r.currentStatus === 'exception'
            ? 'bg-rose-500/10 text-rose-500 border-rose-500/25'
            : 'bg-amber-500/10 text-amber-500 border-amber-500/25';

        const lastEv = r.events[0];

        return `
          <tr class="hover:bg-[var(--bg-card-hover)] transition-colors">
            <td class="p-3.5 pl-4 font-mono font-bold text-[var(--text-main)]">
              <div class="flex items-center gap-2">
                <span>${r.consignmentNumber}</span>
                <button type="button" class="copy-cell-btn text-[10px] text-[var(--text-subtle)] hover:text-rose-500" data-awb="${r.consignmentNumber}" title="Copy AWB">
                  📋
                </button>
              </div>
            </td>
            <td class="p-3.5">
              <span class="inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-semibold gap-1.5 ${statusBadgeClass}">
                <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                <span>${r.statusLabel}</span>
              </span>
            </td>
            <td class="p-3.5 text-[var(--text-muted)]">
              <span class="truncate block max-w-[180px]">${r.bookedAt.split('(')[0]} ➔ ${r.destinationOffice.split('(')[0]}</span>
            </td>
            <td class="p-3.5">
              <span class="font-medium text-[var(--text-main)] block">${lastEv?.event ?? 'Dispatched'}</span>
              <span class="text-[11px] text-[var(--text-subtle)] font-mono block">${lastEv?.date ?? ''} ${lastEv?.time ?? ''}</span>
            </td>
            <td class="p-3.5 pr-4 text-right">
              <a
                href="/?consignment=${encodeURIComponent(r.consignmentNumber)}"
                class="px-2.5 py-1 rounded-lg text-xs font-medium border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-muted)] hover:text-rose-500 hover:border-rose-500/30 transition-colors inline-block"
              >
                Track Map ➔
              </a>
            </td>
          </tr>
        `;
      })
      .join('');

    tableBody.querySelectorAll('.copy-cell-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const awb = btn.getAttribute('data-awb');
        if (awb && navigator.clipboard) {
          navigator.clipboard.writeText(awb);
          if ((window as unknown as { showToast?: (m: string) => void }).showToast) {
            (window as unknown as { showToast: (m: string) => void }).showToast(`Copied ${awb}`);
          }
        }
      });
    });
  }

  // Filter Tabs
  document.querySelectorAll('.filter-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.filter-tab').forEach((t) => {
        t.classList.remove('bg-rose-600', 'text-white', 'font-semibold');
        t.classList.add('text-[var(--text-muted)]', 'font-medium');
      });
      tab.classList.add('bg-rose-600', 'text-white', 'font-semibold');
      tab.classList.remove('text-[var(--text-muted)]', 'font-medium');

      currentFilter = tab.getAttribute('data-filter') || 'all';
      renderTable();
    });
  });

  // Export CSV
  document.getElementById('export-csv-btn')?.addEventListener('click', () => {
    if (currentResults.length === 0) return;

    const headers = ['Consignment Number', 'Status', 'Booked At', 'Destination Pincode', 'Delivered At', 'Latest Event', 'Latest Date'];
    const rows = currentResults.map((r) => [
      `"${r.consignmentNumber}"`,
      `"${r.currentStatus}"`,
      `"${r.bookedAt}"`,
      `"${r.destinationPincode}"`,
      `"${r.deliveredAt || ''}"`,
      `"${r.events[0]?.event || ''}"`,
      `"${r.events[0]?.date || ''} ${r.events[0]?.time || ''}"`,
    ]);

    const csvContent = [headers.join(','), ...rows.map((row) => row.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `speedpost-audit-${new Date().toISOString().slice(0, 10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // Export JSON
  document.getElementById('export-json-btn')?.addEventListener('click', () => {
    if (currentResults.length === 0) return;
    const blob = new Blob([JSON.stringify(currentResults, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `speedpost-audit-${new Date().toISOString().slice(0, 10)}.json`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });
</script>
