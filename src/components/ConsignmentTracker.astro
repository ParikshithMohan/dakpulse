---
import BarcodeScannerModal from './BarcodeScannerModal.astro';
import RouteMap from './RouteMap.astro';
import TrackingTimeline from './TrackingTimeline.astro';
import type { TrackingResult } from '../lib/types';

interface Props {
  initialData?: TrackingResult | null;
  initialAwb?: string;
}

const { initialData = null, initialAwb = '' } = Astro.props;
---

<div class="space-y-10">
  <!-- Search Box Header Card -->
  <div class="p-6 sm:p-10 rounded-3xl border border-[var(--border)] bg-gradient-to-b from-[var(--bg-card)] to-[var(--bg-card)]/50 shadow-xl relative overflow-hidden">
    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-rose-600/10 blur-3xl pointer-events-none"></div>

    <div class="max-w-2xl mx-auto text-center space-y-3 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
        <span>🇮🇳</span> Official Consignment Tracker
      </div>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-[var(--text-main)]">
        Speed Post Tracking for India Post
      </h1>
      <p class="text-sm text-[var(--text-muted)] max-w-lg mx-auto">
        Live status, sorting hub scan events, and interactive route mapping for any Indian Speed Post consignment.
      </p>

      <!-- Main Search Form -->
      <form id="tracking-search-form" class="mt-8 flex flex-col sm:flex-row items-center gap-2 max-w-xl mx-auto">
        <div class="relative w-full flex-1">
          <input
            id="consignment-input"
            type="text"
            name="consignment"
            value={initialAwb}
            placeholder="e.g. CX137150258IN or JA075033095IN"
            autocomplete="off"
            spellcheck="false"
            required
            class="w-full h-13 pl-4 pr-24 rounded-2xl border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-main)] placeholder-[var(--text-subtle)] text-sm sm:text-base font-mono font-semibold uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all shadow-inner"
          />

          <!-- Scanner Trigger Button -->
          <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
            <button
              id="open-scanner-btn"
              type="button"
              class="h-9 px-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-card)] hover:bg-[var(--bg-card-hover)] text-xs font-medium text-[var(--text-muted)] hover:text-rose-500 flex items-center gap-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 cursor-pointer"
              title="Scan Barcode / QR with camera"
            >
              <span>📷</span>
              <span class="hidden sm:inline">Scan</span>
            </button>
          </div>
        </div>

        <button
          type="submit"
          id="submit-track-btn"
          class="w-full sm:w-auto h-13 px-8 rounded-2xl bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-500 hover:to-red-400 text-white font-bold text-sm tracking-wide shadow-lg shadow-rose-600/25 transition-all flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-rose-500 cursor-pointer"
        >
          <span id="btn-text">Track</span>
          <span id="btn-spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
        </button>
      </form>

      <!-- Quick Sample Parcels -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="text-[var(--text-subtle)] font-medium">Try Live Samples:</span>
        <button
          type="button"
          class="sample-pill px-2.5 py-1 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono text-xs hover:scale-105 transition-transform cursor-pointer"
          data-awb="CX137150258IN"
        >
          CX137150258IN (Real Live AWB)
        </button>
        <button
          type="button"
          class="sample-pill px-2.5 py-1 rounded-lg border border-blue-500/30 bg-blue-500/10 text-blue-600 dark:text-blue-400 font-mono text-xs hover:scale-105 transition-transform cursor-pointer"
          data-awb="JA075033095IN"
        >
          JA075033095IN (Live Speed Post)
        </button>
        <button
          type="button"
          class="sample-pill px-2.5 py-1 rounded-lg border border-amber-500/30 bg-amber-500/10 text-amber-600 dark:text-amber-400 font-mono text-xs hover:scale-105 transition-transform cursor-pointer"
          data-awb="EK982143051IN"
        >
          EK982143051IN (In Transit)
        </button>
        <button
          type="button"
          class="sample-pill px-2.5 py-1 rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-600 dark:text-rose-400 font-mono text-xs hover:scale-105 transition-transform cursor-pointer"
          data-awb="EU781920394IN"
        >
          EU781920394IN (Exception)
        </button>
      </div>

      <!-- Recent Consignments -->
      <div id="recent-searches-container" class="hidden pt-3 flex-wrap items-center justify-center gap-2 text-xs">
        <span class="text-[var(--text-subtle)]">Recent:</span>
        <div id="recent-chips" class="inline-flex flex-wrap gap-1.5"></div>
        <button id="clear-recent-btn" type="button" class="text-[11px] text-[var(--text-subtle)] hover:text-rose-500 underline ml-1 cursor-pointer">
          Clear
        </button>
      </div>
    </div>
  </div>

  <!-- Error Alert Container -->
  <div id="tracking-error" class="hidden p-4 rounded-2xl bg-rose-500/10 border border-rose-500/25 text-rose-600 dark:text-rose-400 text-xs font-medium max-w-xl mx-auto flex items-start gap-3">
    <span class="text-base">⚠️</span>
    <div id="error-message"></div>
  </div>

  <!-- Dynamic Results Container -->
  <div id="results-view" class={initialData ? 'space-y-8' : 'hidden space-y-8'}>
    {initialData && (
      <>
        <TrackingTimeline data={initialData} />
        <RouteMap route={initialData.route} />
      </>
    )}
  </div>
</div>

<BarcodeScannerModal />

<!-- Confetti bundle for delivery celebration -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.4/dist/confetti.browser.min.js" is:inline></script>

<script>
  const form = document.getElementById('tracking-search-form') as HTMLFormElement | null;
  const input = document.getElementById('consignment-input') as HTMLInputElement | null;
  const openScannerBtn = document.getElementById('open-scanner-btn');
  const resultsView = document.getElementById('results-view');
  const errorBox = document.getElementById('tracking-error');
  const errorMsg = document.getElementById('error-message');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const recentContainer = document.getElementById('recent-searches-container');
  const recentChips = document.getElementById('recent-chips');
  const clearRecentBtn = document.getElementById('clear-recent-btn');

  // Load Recents
  function loadRecents() {
    try {
      const stored = JSON.parse(localStorage.getItem('speedpost-recents') || '[]');
      if (Array.isArray(stored) && stored.length > 0 && recentContainer && recentChips) {
        recentContainer.classList.remove('hidden');
        recentContainer.classList.add('flex');
        recentChips.innerHTML = stored
          .slice(0, 5)
          .map(
            (awb: string) =>
              `<button type="button" class="recent-pill px-2 py-0.5 rounded bg-[var(--bg-page)] border border-[var(--border)] font-mono text-[11px] text-[var(--text-muted)] hover:text-[var(--text-main)] hover:border-rose-500/50 cursor-pointer" data-awb="${awb}">${awb}</button>`
          )
          .join('');

        recentChips.querySelectorAll('.recent-pill').forEach((btn) => {
          btn.addEventListener('click', () => {
            const awb = btn.getAttribute('data-awb');
            if (awb && input) {
              input.value = awb;
              void executeTrack(awb);
            }
          });
        });
      }
    } catch (e) {}
  }

  function saveRecent(awb: string) {
    try {
      const stored = JSON.parse(localStorage.getItem('speedpost-recents') || '[]');
      const updated = [awb, ...stored.filter((x: string) => x !== awb)].slice(0, 10);
      localStorage.setItem('speedpost-recents', JSON.stringify(updated));
      loadRecents();
    } catch (e) {}
  }

  clearRecentBtn?.addEventListener('click', () => {
    localStorage.removeItem('speedpost-recents');
    if (recentContainer) {
      recentContainer.classList.add('hidden');
      recentContainer.classList.remove('flex');
    }
  });

  // Trigger Delivery Confetti
  function triggerConfetti() {
    const confetti = (window as unknown as { confetti?: (opts: unknown) => void }).confetti;
    if (typeof confetti === 'function') {
      confetti({
        particleCount: 80,
        spread: 60,
        origin: { y: 0.6 },
      });
    }
  }

  // Format Input automatically
  input?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    target.value = target.value.toUpperCase().replace(/[\s-]/g, '');
  });

  // Scanner open trigger
  openScannerBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-qr-scanner'));
  });

  // Scanner result listener
  window.addEventListener('consignment-scanned', ((e: CustomEvent<{ code: string }>) => {
    if (input && e.detail?.code) {
      input.value = e.detail.code;
      void executeTrack(e.detail.code);
    }
  }) as EventListener);

  // Sample pill clicks
  document.querySelectorAll('.sample-pill').forEach((btn) => {
    btn.addEventListener('click', () => {
      const awb = btn.getAttribute('data-awb');
      if (awb && input) {
        input.value = awb;
        void executeTrack(awb);
      }
    });
  });

  // Track Execution
  async function executeTrack(awb: string) {
    const cleaned = awb.trim().toUpperCase().replace(/[\s-]/g, '');
    if (!cleaned) return;

    if (errorBox) errorBox.classList.add('hidden');
    if (btnText) btnText.textContent = 'Tracking…';
    if (btnSpinner) btnSpinner.classList.remove('hidden');

    try {
      const res = await fetch(`/api/track?consignment=${encodeURIComponent(cleaned)}`);
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to locate consignment');
      }

      saveRecent(cleaned);
      history.replaceState(null, '', `/?consignment=${encodeURIComponent(cleaned)}`);

      // Update Result View HTML dynamically in-place
      renderTrackingResult(data.data);

      if (data.data.currentStatus === 'delivered') {
        triggerConfetti();
      }
    } catch (err) {
      if (errorBox && errorMsg) {
        errorBox.classList.remove('hidden');
        errorMsg.textContent = (err as Error).message || 'Invalid consignment number or connection failed.';
      }
      if (resultsView) resultsView.classList.add('hidden');
    } finally {
      if (btnText) btnText.textContent = 'Track';
      if (btnSpinner) btnSpinner.classList.add('hidden');
    }
  }

  function renderTrackingResult(result: unknown) {
    if (!resultsView) return;
    const r = result as {
      consignmentNumber: string;
      articleType: string;
      bookedAt: string;
      bookedOn: string;
      destinationOffice: string;
      destinationPincode: string;
      currentStatus: string;
      statusLabel: string;
      deliveredAt: string | null;
      recipient: string | null;
      events: Array<{ date: string; time: string; office: string; event: string; details?: string; status: string }>;
      route: Array<{ lat: number; lng: number; label: string; isOrigin?: boolean; isDestination?: boolean }>;
    };

    const stepMap: Record<string, number> = {
      booked: 0,
      dispatched: 1,
      in_transit: 2,
      out_for_delivery: 3,
      delivered: 4,
      exception: 2,
      rto: 2,
    };
    const currentStep = stepMap[r.currentStatus] ?? 1;

    const steps = [
      { label: 'Booked', desc: r.bookedAt.split('(')[0].trim() },
      { label: 'Dispatched', desc: 'Mail Sorting' },
      { label: 'In Transit', desc: 'Inter-City Hub' },
      { label: 'Out for Delivery', desc: 'Postman Beat' },
      { label: 'Delivered', desc: r.deliveredAt ? r.deliveredAt.split(' ')[0] : 'Pending' },
    ];

    const statusBadgeClass =
      r.currentStatus === 'delivered'
        ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/25'
        : r.currentStatus === 'out_for_delivery'
        ? 'bg-blue-500/10 text-blue-500 border-blue-500/25'
        : r.currentStatus === 'exception'
        ? 'bg-rose-500/10 text-rose-500 border-rose-500/25'
        : 'bg-amber-500/10 text-amber-500 border-amber-500/25';

    resultsView.innerHTML = `
      <div class="space-y-6">
        <!-- Progress Bar Card -->
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]">
          <div class="flex items-center justify-between mb-6 flex-wrap gap-2">
            <div>
              <span class="text-xs uppercase tracking-wider text-[var(--text-subtle)] font-semibold">Consignment Number</span>
              <div class="flex items-center gap-3 mt-1">
                <h2 class="text-xl sm:text-2xl font-black font-mono tracking-tight text-[var(--text-main)]">
                  ${r.consignmentNumber}
                </h2>
                <button type="button" id="copy-dyn-btn" class="px-2 py-1 rounded-md text-xs font-medium border border-[var(--border)] bg-[var(--bg-page)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors cursor-pointer">
                  📋 Copy
                </button>
              </div>
            </div>
            <div>
              <span class="inline-flex items-center rounded-full border px-3 py-1.5 text-xs font-semibold gap-2 ${statusBadgeClass}">
                <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
                <span>${r.statusLabel}</span>
              </span>
            </div>
          </div>

          <div class="relative py-2">
            <div class="hidden sm:block absolute top-6 left-6 right-6 h-1 bg-[var(--border)] rounded-full -z-0">
              <div class="h-full bg-gradient-to-r from-emerald-500 via-rose-500 to-emerald-500 rounded-full transition-all duration-500" style="width: ${(currentStep / 4) * 100}%"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-5 gap-4 relative z-10">
              ${steps
                .map((step, idx) => {
                  const isDone = idx < currentStep;
                  const isCur = idx === currentStep;
                  const nodeBg = isCur
                    ? 'bg-rose-600 text-white ring-4 ring-rose-500/20 scale-110'
                    : isDone
                    ? 'bg-emerald-600 text-white'
                    : 'bg-[var(--bg-page)] border-2 border-[var(--border)] text-[var(--text-subtle)]';

                  return `
                    <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-2">
                      <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs shrink-0 ${nodeBg}">
                        ${isDone ? '✓' : idx + 1}
                      </div>
                      <div class="text-left sm:text-center">
                        <p class="text-xs font-bold leading-tight ${isCur ? 'text-rose-500' : 'text-[var(--text-main)]'}">${step.label}</p>
                        <p class="text-[11px] text-[var(--text-subtle)] mt-0.5 truncate max-w-[140px]">${step.desc}</p>
                      </div>
                    </div>
                  `;
                })
                .join('')}
            </div>
          </div>
        </div>

        <!-- Metadata Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--bg-card)]">
            <span class="text-[11px] text-[var(--text-subtle)] block">Article Type</span>
            <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate">${r.articleType}</strong>
          </div>
          <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--bg-card)]">
            <span class="text-[11px] text-[var(--text-subtle)] block">Booked At</span>
            <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate">${r.bookedAt}</strong>
          </div>
          <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--bg-card)]">
            <span class="text-[11px] text-[var(--text-subtle)] block">Destination</span>
            <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate font-mono">${r.destinationOffice || r.destinationPincode}</strong>
          </div>
          <div class="p-4 rounded-xl border border-[var(--border)] bg-[var(--bg-card)]">
            <span class="text-[11px] text-[var(--text-subtle)] block">Delivery Status</span>
            <strong class="text-xs sm:text-sm font-semibold text-[var(--text-main)] mt-0.5 block truncate">${r.statusLabel}</strong>
          </div>
        </div>

        <!-- Event Timeline -->
        <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]">
          <div class="flex items-center justify-between pb-4 mb-4 border-b border-[var(--border)]">
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-bold text-[var(--text-main)]">Detailed Scan Log & Audit Trail</h3>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[var(--bg-page)] text-[var(--text-muted)] border border-[var(--border)]">
                ${r.events.length} Scans
              </span>
            </div>
            <button type="button" onclick="window.print()" class="text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text-main)] flex items-center gap-1.5 focus:outline-none cursor-pointer">
              <span>🖨️</span> Print Slip
            </button>
          </div>
          <div class="space-y-4">
            ${r.events
              .map(
                (ev, i) => `
              <div class="flex items-start gap-4 text-xs group">
                <div class="w-24 shrink-0 text-right">
                  <span class="font-mono font-bold text-[var(--text-main)] block">${ev.date}</span>
                  <span class="font-mono text-[11px] text-[var(--text-subtle)] block">${ev.time}</span>
                </div>
                <div class="relative flex flex-col items-center shrink-0 self-stretch">
                  <div class="w-2.5 h-2.5 rounded-full mt-1.5 ${i === 0 ? 'bg-rose-500 ring-4 ring-rose-500/20' : 'bg-[var(--border-subtle)]'}"></div>
                  ${i !== r.events.length - 1 ? '<div class="w-0.5 flex-1 bg-[var(--border)] my-1"></div>' : ''}
                </div>
                <div class="flex-1 pb-3">
                  <span class="font-bold text-[var(--text-main)]">${ev.event}</span>
                  <p class="text-[var(--text-muted)] mt-0.5">${ev.office}</p>
                  ${ev.details ? `<p class="text-[11px] text-[var(--text-subtle)] mt-1 font-mono">${ev.details}</p>` : ''}
                </div>
              </div>
            `
              )
              .join('')}
          </div>
        </div>

        <!-- Route Map Container -->
        <div class="relative w-full h-[320px] sm:h-[380px] rounded-3xl overflow-hidden border border-[var(--border)] bg-[var(--bg-card)] shadow-inner">
          <div id="leaflet-route-map" class="w-full h-full"></div>
          <div class="absolute top-4 right-4 z-[1000] px-3 py-1.5 rounded-xl bg-[var(--bg-card)]/90 backdrop-blur-md border border-[var(--border)] text-xs font-semibold text-[var(--text-main)] flex items-center gap-2 shadow-lg">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
            <span>Live Transit Corridor</span>
          </div>
          <div class="absolute bottom-3 left-3 z-[1000] px-2.5 py-1 rounded-lg bg-[var(--bg-card)]/90 backdrop-blur-md border border-[var(--border)] text-[10px] text-[var(--text-subtle)] font-mono shadow-sm pointer-events-none">
            India Post RMS & Air Transit Grid
          </div>
        </div>
      </div>
    `;

    resultsView.classList.remove('hidden');

    // Wire Copy Button
    document.getElementById('copy-dyn-btn')?.addEventListener('click', () => {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(r.consignmentNumber);
        if ((window as unknown as { showToast?: (m: string) => void }).showToast) {
          (window as unknown as { showToast: (m: string) => void }).showToast(`Copied ${r.consignmentNumber}`);
        }
      }
    });

    // Update Route Map smoothly without page refresh
    const updateFn = (window as unknown as { updateRouteMap?: (route: unknown) => void }).updateRouteMap;
    if (typeof updateFn === 'function' && r.route && r.route.length > 0) {
      updateFn(r.route);
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) void executeTrack(input.value);
  });

  // Initial load
  loadRecents();
</script>
