---
import type { GeoCoordinate } from '../lib/types';

interface Props {
  route: GeoCoordinate[];
}

const { route } = Astro.props;
---

<div class="relative w-full h-[360px] sm:h-[420px] rounded-xl overflow-hidden border border-zinc-800 bg-[#0d0e12] shadow-xl">
  <div id="leaflet-route-map" class="w-full h-full min-h-[360px]" style="min-height: 360px; height: 100%;"></div>
  
  <!-- Overlay Corridor Badge -->
  <div class="absolute top-3 right-3 z-[1000] px-3 py-1 rounded-md bg-zinc-950/90 border border-zinc-800 text-xs font-mono font-medium text-white flex items-center gap-2 shadow-md backdrop-blur-md">
    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
    <span class="font-semibold text-[11px] uppercase tracking-wider">Transit Corridor Polyline</span>
  </div>

  <div class="absolute bottom-3 left-3 z-[1000] px-2.5 py-1 rounded-md bg-zinc-950/90 border border-zinc-800 text-[10px] text-zinc-400 font-mono shadow-md pointer-events-none backdrop-blur-md">
    OpenStreetMap Geospatial Telemetry
  </div>
</div>

<script define:vars={{ initialRoute: route }}>
  function renderMapInstance(coords) {
    if (typeof window === 'undefined' || !window.L) return;
    const container = document.getElementById('leaflet-route-map');
    if (!container) return;

    if (window.__LEAFLET_MAP_INSTANCE__) {
      try {
        window.__LEAFLET_MAP_INSTANCE__.remove();
      } catch (e) {}
      window.__LEAFLET_MAP_INSTANCE__ = null;
    }
    delete container._leaflet_id;

    const L = window.L;
    if (!coords || coords.length === 0) return;

    const map = L.map(container, {
      zoomControl: true,
      attributionControl: false,
      scrollWheelZoom: false,
    });

    // Reliable OpenStreetMap tiles without any API key requirements
    const tileLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      subdomains: 'abc',
    }).addTo(map);

    window.__LEAFLET_TILE_LAYER__ = tileLayer;

    const latlngs = coords.map((c) => [c.lat, c.lng]);

    // If 2 or more coordinates, draw polyline route
    if (latlngs.length >= 2) {
      L.polyline(latlngs, {
        color: '#dc2626',
        weight: 3.5,
        opacity: 0.9,
        dashArray: '6, 6',
        lineCap: 'round',
      }).addTo(map);

      const bounds = L.latLngBounds(latlngs);
      map.fitBounds(bounds, { padding: [45, 45], maxZoom: 14 });
    } else if (latlngs.length === 1) {
      map.setView(latlngs[0], 11);
    }

    // Add markers for each hub
    coords.forEach((point, i) => {
      const isOrigin = i === 0 || point.isOrigin;
      const isDestination = i === coords.length - 1 || point.isDestination;

      const markerColor = isOrigin ? '#16a34a' : isDestination ? '#dc2626' : '#2563eb';
      const markerSize = isOrigin || isDestination ? 14 : 10;
      const anchor = markerSize / 2;

      const markerHtml = `<div style="background:${markerColor}; width:${markerSize}px; height:${markerSize}px; border:2px solid #ffffff; border-radius:50%; box-shadow:0 0 10px rgba(0,0,0,0.5);"></div>`;

      const icon = L.divIcon({
        className: 'custom-div-icon',
        html: markerHtml,
        iconSize: [markerSize, markerSize],
        iconAnchor: [anchor, anchor],
      });

      L.marker([point.lat, point.lng], { icon })
        .addTo(map)
        .bindPopup(
          `<div style="font-family:'Plus Jakarta Sans', system-ui, sans-serif; font-size:12px; color:#111827; padding:4px;">
            <strong style="color:${markerColor}">${isOrigin ? 'Origin Booking Office' : isDestination ? 'Destination Delivery Office' : 'Sorting Hub (RMS / TMO)'}</strong>
            <p style="margin:2px 0 0 0; color:#4b5563; font-weight:600;">${point.label}</p>
          </div>`
        );
    });

    // Invalidate size on next ticks to ensure tiles render regardless of container animation
    setTimeout(() => map.invalidateSize(), 100);
    setTimeout(() => map.invalidateSize(), 300);

    // Watch container size changes via ResizeObserver
    if (typeof ResizeObserver !== 'undefined') {
      const ro = new ResizeObserver(() => {
        map.invalidateSize();
      });
      ro.observe(container);
    }

    window.__LEAFLET_MAP_INSTANCE__ = map;
  }

  // Global updater function for client-side search updates
  window.updateRouteMap = function (newRoute) {
    if (!newRoute || newRoute.length === 0) return;
    window.__CURRENT_ROUTE__ = newRoute;

    if (!window.L) {
      loadLeafletScript(() => renderMapInstance(newRoute));
    } else {
      setTimeout(() => renderMapInstance(newRoute), 50);
    }
  };

  function loadLeafletScript(cb) {
    if (window.L) {
      cb();
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
    script.crossOrigin = '';
    script.onload = () => {
      cb();
    };
    document.head.appendChild(script);
  }

  // Initial SSR Route Load
  if (initialRoute && initialRoute.length > 0) {
    window.__CURRENT_ROUTE__ = initialRoute;
    loadLeafletScript(() => renderMapInstance(initialRoute));
  }
</script>
