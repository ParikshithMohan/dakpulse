---
import type { GeoCoordinate } from '../lib/types';

interface Props {
  route: GeoCoordinate[];
}

const { route } = Astro.props;
---

<div class="relative w-full h-[320px] sm:h-[380px] rounded-3xl overflow-hidden border border-[var(--border)] bg-[var(--bg-card)] shadow-inner">
  <div id="leaflet-route-map" class="w-full h-full"></div>
  
  <!-- Overlay Corridor Badge -->
  <div class="absolute top-4 right-4 z-[1000] px-3 py-1.5 rounded-xl bg-[var(--bg-card)]/90 backdrop-blur-md border border-[var(--border)] text-xs font-semibold text-[var(--text-main)] flex items-center gap-2 shadow-lg">
    <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
    <span>Live Transit Corridor</span>
  </div>

  <div class="absolute bottom-3 left-3 z-[1000] px-2.5 py-1 rounded-lg bg-[var(--bg-card)]/90 backdrop-blur-md border border-[var(--border)] text-[10px] text-[var(--text-subtle)] font-mono shadow-sm pointer-events-none">
    India Post RMS & Air Transit Grid
  </div>
</div>

<style is:global>
  /* Dark Mode Map Inversion for clean night theme */
  [data-theme="dark"] .leaflet-tile-pane {
    filter: brightness(0.7) invert(1) contrast(1.8) hue-rotate(200deg) saturate(0.3);
  }
</style>

<script define:vars={{ initialRoute: route }}>
  function loadMap() {
    if (typeof window === 'undefined' || !window.L) {
      setTimeout(loadMap, 100);
      return;
    }

    const L = window.L;
    const container = document.getElementById('leaflet-route-map');
    if (!container) return;

    if (window.__LEAFLET_MAP_INSTANCE__) {
      window.__LEAFLET_MAP_INSTANCE__.remove();
      delete container._leaflet_id;
    }

    const coords = (window.__CURRENT_ROUTE__ || initialRoute || []);
    if (!coords || coords.length === 0) return;

    // Standard OpenStreetMap tiles - 100% Free, NO API Key watermark
    const tileUrl = 'https://tile.openstreetmap.org/{z}/{x}/{y}.png';

    const map = L.map('leaflet-route-map', {
      zoomControl: true,
      attributionControl: false,
      scrollWheelZoom: false,
    });

    L.tileLayer(tileUrl, {
      maxZoom: 18,
    }).addTo(map);

    const latlngs = coords.map((c) => [c.lat, c.lng]);
    const bounds = L.latLngBounds(latlngs);

    // Draw route line
    L.polyline(latlngs, {
      color: '#e11d48',
      weight: 4,
      opacity: 0.9,
      dashArray: '8, 8',
      lineCap: 'round',
    }).addTo(map);

    // Add markers
    coords.forEach((point, i) => {
      const isOrigin = i === 0 || point.isOrigin;
      const isDestination = i === coords.length - 1 || point.isDestination;

      const markerHtml = isOrigin
        ? `<div style="background:#10b981; width:16px; height:16px; border:2.5px solid white; border-radius:50%; box-shadow:0 0 12px rgba(16,185,129,0.9);"></div>`
        : isDestination
        ? `<div style="background:#e11d48; width:16px; height:16px; border:2.5px solid white; border-radius:50%; box-shadow:0 0 14px rgba(225,29,72,1);"></div>`
        : `<div style="background:#3b82f6; width:12px; height:12px; border:2px solid white; border-radius:50%; box-shadow:0 0 8px rgba(59,130,246,0.8);"></div>`;

      const icon = L.divIcon({
        className: 'custom-div-icon',
        html: markerHtml,
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });

      L.marker([point.lat, point.lng], { icon })
        .addTo(map)
        .bindPopup(
          `<div style="font-family:system-ui, sans-serif; font-size:12px; color:#09090b; padding:4px;">
            <strong style="color:${isOrigin ? '#059669' : isDestination ? '#e11d48' : '#2563eb'}">${isOrigin ? 'Origin Booking Post Office' : isDestination ? 'Destination Delivery Post Office' : 'Postal Sorting Hub (RMS/NSH)'}</strong>
            <p style="margin:3px 0 0 0; color:#52525b; font-weight:600;">${point.label}</p>
          </div>`
        );
    });

    map.fitBounds(bounds, { padding: [50, 50] });
    window.__LEAFLET_MAP_INSTANCE__ = map;
  }

  // Global updater function for client-side search updates
  window.updateRouteMap = function(newRoute) {
    if (!newRoute || newRoute.length === 0) return;
    window.__CURRENT_ROUTE__ = newRoute;
    loadMap();
  };

  // Load Leaflet script if not yet loaded
  if (!window.L) {
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    script.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
    script.crossOrigin = '';
    script.onload = loadMap;
    document.head.appendChild(script);
  } else {
    loadMap();
  }
</script>
