---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'MySpeedPost – Live India Post Tracking & Postal Suite',
  description = 'Fast, ad-free India Post Speed Post tracking with live transit timeline, interactive route map, camera barcode scanning, and postal pincode directory.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23e11d48'/><text x='50%' y='68%' font-size='50' font-weight='900' fill='white' text-anchor='middle'>SP</text></svg>" />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('speedpost-theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-page)] text-[var(--text-main)] transition-colors antialiased">
    <Navigation />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- Footer -->
    <footer class="border-t border-[var(--border)] bg-[var(--bg-card)] mt-20 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2">
              <span class="w-7 h-7 rounded-lg bg-rose-600 flex items-center justify-center text-white font-black text-sm">SP</span>
              <span class="font-bold text-sm tracking-tight text-[var(--text-main)]">MySpeedPost Pro</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">
              Standalone India Post consignment tracker & postal suite. Optimized for high-volume dispatchers, e-commerce web admins, and everyday postal consignees.
            </p>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-[11px] font-mono text-emerald-500 bg-emerald-500/10 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Localhost Engine • Sub-second
            </div>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-main)] mb-3">India Post Services</h4>
            <ul class="space-y-2 text-xs text-[var(--text-muted)]">
              <li><span class="hover:text-[var(--text-main)] cursor-default">Speed Post (Domestic & International)</span></li>
              <li><span class="hover:text-[var(--text-main)] cursor-default">Express Parcel & Business Parcel</span></li>
              <li><span class="hover:text-[var(--text-main)] cursor-default">Registered Post & Value Payable Post</span></li>
              <li><span class="hover:text-[var(--text-main)] cursor-default">Postal Life Insurance (PLI)</span></li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-main)] mb-3">Consignment Formats</h4>
            <ul class="space-y-2 text-xs text-[var(--text-muted)] font-mono">
              <li><span class="text-rose-500 font-semibold">EK...IN</span> Speed Post Standard</li>
              <li><span class="text-blue-500 font-semibold">CX...IN</span> Express Parcel Post</li>
              <li><span class="text-indigo-500 font-semibold">EM...IN</span> Air Mail EMS</li>
              <li><span class="text-emerald-500 font-semibold">ED...IN</span> Business Domestic Post</li>
            </ul>
          </div>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-main)] mb-3">E-Commerce Ready</h4>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-3">
              Designed to integrate with trading card & e-commerce brands like <strong class="text-[var(--text-main)]">RockyTCG</strong>. Component structure matches Astro 6 + Tailwind CSS v4.
            </p>
            <div class="text-[11px] text-[var(--text-subtle)]">
              Press <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-page)] border border-[var(--border)] font-mono text-[10px]">Esc</kbd> to close any modal.
            </div>
          </div>
        </div>

        <div class="border-t border-[var(--border)] pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-subtle)] gap-4">
          <p>© 2026 MySpeedPost Localhost Replica. Clean architecture with zero tracker bloat.</p>
          <div class="flex items-center gap-4">
            <span>Postal APIs: Public Gov Directory</span>
            <span>•</span>
            <span>Speed: Instant</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Toast Script -->
    <script is:inline>
      window.showToast = function (message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto px-4 py-3 rounded-xl border shadow-xl text-xs font-medium flex items-center gap-2 transform transition-all duration-300 translate-y-2 opacity-0 ${
          type === 'success'
            ? 'bg-emerald-950/90 text-emerald-200 border-emerald-500/30'
            : type === 'error'
            ? 'bg-rose-950/90 text-rose-200 border-rose-500/30'
            : 'bg-zinc-900/90 text-zinc-200 border-zinc-700/50'
        }`;

        const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
        toast.innerHTML = `<span class="font-bold">${icon}</span> <span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      };
    </script>
  </body>
</html>
