---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DakPulse – India Post Tracking & Delivery Calculator',
  description = 'Fast, ad-free India Post Speed Post tracking, real-time routing map, 154,000+ postal pincode directory, and instant postage rate calculator.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-astryx-theme="neutral">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23dc2626'/><path d='M25 35 L50 52 L75 35' stroke='white' stroke-width='7' stroke-linecap='round' stroke-linejoin='round' fill='none'/><path d='M25 40 L25 68 C25 70 27 72 29 72 L71 72 C73 72 75 70 75 68 L75 40' stroke='white' stroke-width='7' stroke-linecap='round' stroke-linejoin='round' fill='none'/><circle cx='70' cy='62' r='4' fill='%23fef08a'/></svg>" />

    <!-- Google Fonts: Space Grotesk + Plus Jakarta Sans + Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Theme Initialization Script -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('dakpulse-theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-page)] text-[var(--text-main)] transition-colors antialiased selection:bg-red-500/20 selection:text-red-400">
    <Navigation />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10">
      <slot />
    </main>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- Clean Industrial Footer -->
    <footer class="border-t border-[var(--border)] bg-[var(--bg-card)] mt-20 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="space-y-3 md:col-span-1">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white shadow-sm">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h9"></path>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  <path d="m16 19 2 2 4-4"></path>
                </svg>
              </div>
              <span class="font-heading font-bold text-lg tracking-tight text-[var(--text-main)]">DakPulse</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">
              Fast, privacy-first tracking and postage calculator for India Post Speed Post and parcel consignments.
            </p>
          </div>

          <div>
            <h4 class="font-heading text-xs uppercase tracking-wider text-[var(--text-main)] mb-3">Quick Navigation</h4>
            <ul class="space-y-2 text-xs text-[var(--text-muted)]">
              <li><a href="/" class="hover:text-[var(--text-main)] transition-colors">Track Consignment</a></li>
              <li><a href="/postage-calculator" class="hover:text-[var(--text-main)] transition-colors">Postage Calculator</a></li>
              <li><a href="/pincode-search" class="hover:text-[var(--text-main)] transition-colors">Pincode Directory</a></li>
              <li><a href="/bulk-tracking" class="hover:text-[var(--text-main)] transition-colors">Bulk Dispatch</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-heading text-xs uppercase tracking-wider text-[var(--text-main)] mb-3">Supported Articles</h4>
            <ul class="space-y-2 text-xs text-[var(--text-muted)] font-mono">
              <li><span class="text-red-500 font-semibold">EM / EK / ED</span> Speed Post Domestic</li>
              <li><span class="text-blue-500 font-semibold">CX / CP</span> Air Parcel / Surface</li>
              <li><span class="text-amber-500 font-semibold">RT / RN</span> Registered Letter</li>
              <li><span class="text-emerald-500 font-semibold">JA / JJ</span> Insured / Tracked Post</li>
            </ul>
          </div>

          <div>
            <h4 class="font-heading text-xs uppercase tracking-wider text-[var(--text-main)] mb-3">About & Open Source</h4>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-3">
              Independent open-source tool built with Astro 5 and Astryx design tokens. No ads, no third-party trackers.
            </p>
            <div class="text-xs">
              <a
                href="https://github.com/ParikshithMohan/dakpulse"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-red-500 hover:text-red-400 font-medium"
              >
                <span>GitHub Repository</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-[var(--border)] pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-subtle)] gap-4">
          <p>© 2026 DakPulse. Open-source postal logistics utilities.</p>
          <div class="flex items-center gap-3">
            <span>Free Public Tool</span>
            <span>•</span>
            <span>Zero Tracking</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Toast Script -->
    <script is:inline>
      window.showToast = function (message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = `pointer-events-auto px-3.5 py-2.5 rounded-lg border shadow-lg text-xs font-medium flex items-center gap-2 transform transition-all duration-200 translate-y-2 opacity-0 ${
          type === 'success'
            ? 'bg-emerald-950/95 text-emerald-200 border-emerald-500/30'
            : type === 'error'
            ? 'bg-red-950/95 text-red-200 border-red-500/30'
            : 'bg-zinc-900/95 text-zinc-200 border-zinc-700/50'
        }`;

        const icon = type === 'success' ? '✓' : type === 'error' ? '✕' : 'ℹ';
        toast.innerHTML = `<span class="font-bold">${icon}</span> <span>${message}</span>`;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 200);
        }, 2800);
      };
    </script>
  </body>
</html>
