---
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'DakPulse – India Post Consignment Telemetry & Logistics Platform',
  description = 'High-velocity India Post Speed Post tracking, real-time routing map, domestic postage rate engine, and 155,000+ postal pincode directory.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" data-astryx-theme="neutral">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='24' fill='%23dc2626'/><path d='M25 35 L50 52 L75 35' stroke='white' stroke-width='7' stroke-linecap='round' stroke-linejoin='round' fill='none'/><path d='M25 40 L25 68 C25 70 27 72 29 72 L71 72 C73 72 75 70 75 68 L75 40' stroke='white' stroke-width='7' stroke-linecap='round' stroke-linejoin='round' fill='none'/><circle cx='70' cy='62' r='4' fill='%2310b981'/></svg>" />

    <!-- Google Fonts: Space Grotesk + Plus Jakarta Sans + Space Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Theme Initialization Script (Defaults strictly to Dark Mode like Linear / Vercel) -->
    <script is:inline>
      try {
        const saved = localStorage.getItem('dakpulse-theme');
        if (saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--bg-page)] text-[var(--text-main)] transition-colors antialiased selection:bg-red-500/20 selection:text-red-400 relative">
    <!-- Ambient Subtle Hairline Grid -->
    <div class="fixed inset-0 grid-hairline pointer-events-none z-0 opacity-40"></div>

    <Navigation />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 relative z-10">
      <slot />
    </main>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- Modern Designer Tech SaaS Footer -->
    <footer class="border-t border-[var(--border)] bg-[var(--bg-card)] mt-24 transition-colors relative z-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-10">
          <!-- Col 1: Brand & Thesis -->
          <div class="space-y-4 md:col-span-1">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white shadow-xs">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 13V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h9"></path>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  <path d="m16 19 2 2 4-4"></path>
                </svg>
              </div>
              <span class="font-heading font-bold text-lg tracking-tight text-[var(--text-main)]">DakPulse</span>
            </div>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed">
              High-velocity postal logistics and consignment telemetry platform for India Post. Sub-second queries, zero advertising, and open architecture.
            </p>
            <div class="flex items-center gap-2 font-mono text-[11px] text-[var(--text-subtle)]">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>155,000+ PIN Codes Indexed</span>
            </div>
          </div>

          <!-- Col 2: Postal Infrastructure Tools -->
          <div>
            <h4 class="font-mono text-xs uppercase tracking-wider text-[var(--text-main)] mb-3 flex items-center gap-2">
              <span class="text-red-500">//</span> Infrastructure Tools
            </h4>
            <ul class="space-y-2.5 text-xs text-[var(--text-muted)]">
              <li><a href="/" class="hover:text-[var(--text-main)] transition-colors">Consignment Tracker</a></li>
              <li><a href="/postage-calculator" class="hover:text-[var(--text-main)] transition-colors">Domestic Tariff Calculator</a></li>
              <li><a href="/pincode-search" class="hover:text-[var(--text-main)] transition-colors">National Pincode Directory</a></li>
              <li><a href="/bulk-tracking" class="hover:text-[var(--text-main)] transition-colors">Bulk Dispatch Manifest</a></li>
            </ul>
          </div>

          <!-- Col 3: Prefix Protocol Guide -->
          <div>
            <h4 class="font-mono text-xs uppercase tracking-wider text-[var(--text-main)] mb-3 flex items-center gap-2">
              <span class="text-emerald-500">//</span> Article Protocols
            </h4>
            <ul class="space-y-2 text-xs text-[var(--text-muted)] font-mono">
              <li><span class="text-red-400 font-semibold">EM / EK / ED</span> Speed Post Domestic</li>
              <li><span class="text-blue-400 font-semibold">CX / CP</span> Air Parcel / Surface</li>
              <li><span class="text-amber-400 font-semibold">RT / RN</span> Registered Letter</li>
              <li><span class="text-emerald-400 font-semibold">JA / JJ</span> Insured / Tracked Post</li>
            </ul>
          </div>

          <!-- Col 4: Open Source & Developer Specs -->
          <div>
            <h4 class="font-mono text-xs uppercase tracking-wider text-[var(--text-main)] mb-3 flex items-center gap-2">
              <span class="text-blue-500">//</span> Open Source & API
            </h4>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-3">
              Independent postal utility. Built on Astro 5 SSR, Leaflet, and open geospatial routing. No tracking cookies or commercial telemetry.
            </p>
            <div>
              <a
                href="https://github.com/ParikshithMohan/dakpulse"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-red-500 hover:text-red-400 font-medium transition-colors"
              >
                <span>GitHub Repository</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-[var(--border)] pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-subtle)] gap-4 font-mono">
          <p>© 2026 DakPulse Platform. Open postal intelligence.</p>
          <div class="flex items-center gap-4">
            <span class="text-emerald-400">Zero Commercial Ads</span>
            <span>•</span>
            <span>MIT Open Source</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Global Keyboard Shortcut Script (Press '/' to focus search) -->
    <script is:inline>
      window.addEventListener('keydown', (e) => {
        if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          e.preventDefault();
          const searchInput = document.getElementById('consignment-input');
          if (searchInput) {
            searchInput.focus();
            searchInput.select();
          }
        }
      });
    </script>
  </body>
</html>
