---
import Layout from '../layouts/Layout.astro';
import ConsignmentTracker from '../components/ConsignmentTracker.astro';
import { getTrackingDetails, sanitizeConsignmentNumber } from '../lib/tracking-engine';

export const prerender = false;

const rawConsignment = Astro.url.searchParams.get('consignment') ?? '';
const sanitized = rawConsignment ? sanitizeConsignmentNumber(rawConsignment) : '';
const initialData = sanitized ? await getTrackingDetails(sanitized) : null;
---

<Layout
  title={
    initialData
      ? `${initialData.consignmentNumber} (${initialData.statusLabel}) | DakPulse Telemetry`
      : 'DakPulse – India Post Consignment Telemetry & Logistics Platform'
  }
  description="Sub-second Speed Post and parcel telemetry for India Post. Algorithmic corridor routing, smart audit trail compaction, and 155,000+ postal pincode directory."
>
  <div class="space-y-20">
    <!-- Main Consignment Tracker & Hero Section -->
    <ConsignmentTracker initialData={initialData} initialAwb={sanitized} />

    <!-- Infrastructure Features Grid (High-Converting SaaS Structure) -->
    <section class="space-y-8 pt-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-[var(--border)] pb-4">
        <div>
          <div class="inline-flex items-center gap-2 font-mono text-[11px] text-red-500 uppercase font-semibold">
            <span>//</span> PLATFORM CAPABILITIES
          </div>
          <h2 class="text-xl sm:text-2xl font-bold font-heading text-[var(--text-main)] tracking-tight mt-1">
            Engineered for Modern Postal Logistics.
          </h2>
        </div>
        <p class="text-xs text-[var(--text-muted)] font-mono">
          SUB-SECOND QUERIES • ZERO ADVERTISING • 100% OPEN DATA
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1: Compacted Audit Trail -->
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6 space-y-4 hover:border-zinc-700 transition-colors">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center font-mono font-bold text-sm">
            01
          </div>
          <h3 class="text-base font-bold text-[var(--text-main)] font-heading">
            Smart Milestone Compaction
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Eliminates noisy, repetitive bag-opening events from Railway Mail Service (RMS) logs. Consolidates 30+ internal scans into 5 high-signal transit milestones.
          </p>
          <div class="pt-2 border-t border-[var(--border)] flex items-center justify-between text-[11px] font-mono text-[var(--text-subtle)]">
            <span>Signal-to-Noise: +85%</span>
            <span class="text-emerald-500 dark:text-emerald-400">Zero Data Loss</span>
          </div>
        </div>

        <!-- Feature 2: Domestic Tariff Calculator -->
        <a href="/postage-calculator" class="group rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6 space-y-4 hover:border-red-500/40 transition-all block">
          <div class="w-10 h-10 rounded-lg bg-red-500/10 border border-red-500/20 text-red-500 dark:text-red-400 flex items-center justify-center font-mono font-bold text-sm group-hover:bg-red-500 group-hover:text-white transition-colors">
            02
          </div>
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[var(--text-main)] font-heading group-hover:text-red-500 transition-colors">
              Domestic Tariff Engine
            </h3>
            <span class="text-[var(--text-subtle)] group-hover:text-red-500 transition-colors">↗</span>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Instant postal tariff computation across India Post weight slabs (50g to 50kg) and distance brackets (Local, 200km, 1000km, >2000km) with live GST breakdown.
          </p>
          <div class="pt-2 border-t border-[var(--border)] flex items-center justify-between text-[11px] font-mono text-[var(--text-subtle)]">
            <span>Speed Post + Parcels</span>
            <span class="text-red-500 dark:text-red-400">Open Calculator</span>
          </div>
        </a>

        <!-- Feature 3: National Pincode Directory -->
        <a href="/pincode-search" class="group rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6 space-y-4 hover:border-blue-500/40 transition-all block">
          <div class="w-10 h-10 rounded-lg bg-blue-500/10 border border-blue-500/20 text-blue-500 dark:text-blue-400 flex items-center justify-center font-mono font-bold text-sm group-hover:bg-blue-500 group-hover:text-white transition-colors">
            03
          </div>
          <div class="flex items-center justify-between">
            <h3 class="text-base font-bold text-[var(--text-main)] font-heading group-hover:text-blue-500 transition-colors">
              155,000+ Pincode Index
            </h3>
            <span class="text-[var(--text-subtle)] group-hover:text-blue-500 transition-colors">↗</span>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Instant lookup for all postal circles, delivery offices, sub-post offices, and district headquarters across India with delivery status indicators.
          </p>
          <div class="pt-2 border-t border-[var(--border)] flex items-center justify-between text-[11px] font-mono text-[var(--text-subtle)]">
            <span>Coverage: 28 States + 8 UTs</span>
            <span class="text-blue-500 dark:text-blue-400">Search Directory</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Developer API & JSON Telemetry Specs -->
    <section class="space-y-6 pt-4">
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-main)]">
            Developer Telemetry API
          </h2>
        </div>
        <span class="font-mono text-[11px] text-[var(--text-subtle)]">RESTful JSON // HTTPS</span>
      </div>

      <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5 sm:p-6 shadow-xl font-mono text-xs space-y-4">
        <div class="flex items-center justify-between text-[var(--text-muted)] pb-3 border-b border-[var(--border)] text-[11px]">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
            <span class="ml-2 text-[var(--text-main)]">terminal@dakpulse-engine:~</span>
          </div>
          <span class="text-[var(--text-subtle)]">bash</span>
        </div>

        <div class="space-y-2">
          <p class="text-[var(--text-subtle)]"># Query real-time India Post consignment status as JSON</p>
          <p class="text-[var(--text-main)]">
            <span class="text-red-500 dark:text-red-400">curl</span> -X GET <span class="text-emerald-500 dark:text-emerald-400">"https://dakpulse.dev/api/track?consignment=EE710744405IN"</span> \
          </p>
          <p class="text-[var(--text-muted)] pl-4">
            -H <span class="text-amber-500 dark:text-amber-400">"Accept: application/json"</span>
          </p>
        </div>

        <div class="pt-3 border-t border-[var(--border)] text-[var(--text-muted)] space-y-1 text-[11px]">
          <p class="text-[var(--text-subtle)]">// Response Payload (200 OK)</p>
          <p class="text-[var(--text-main)]">&#123;</p>
          <p class="pl-4 text-[var(--text-muted)]">"success": <span class="text-emerald-500 dark:text-emerald-400">true</span>,</p>
          <p class="pl-4 text-[var(--text-muted)]">"data": &#123;</p>
          <p class="pl-8 text-[var(--text-muted)]">"consignmentNumber": <span class="text-amber-500 dark:text-amber-300">"EE710744405IN"</span>,</p>
          <p class="pl-8 text-[var(--text-muted)]">"articleType": <span class="text-amber-500 dark:text-amber-300">"Speed Post Domestic"</span>,</p>
          <p class="pl-8 text-[var(--text-muted)]">"currentStatus": <span class="text-emerald-500 dark:text-emerald-400">"delivered"</span>,</p>
          <p class="pl-8 text-[var(--text-muted)]">"destinationOffice": <span class="text-amber-500 dark:text-amber-300">"Wagamon SO (685503)"</span>,</p>
          <p class="pl-8 text-[var(--text-muted)]">"milestonesCount": <span class="text-blue-500 dark:text-blue-400">5</span></p>
          <p class="pl-4 text-[var(--text-muted)]">&#125;</p>
          <p class="text-[var(--text-main)]">&#125;</p>
        </div>
      </div>
    </section>

    <!-- Technical Article Prefix Matrix -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500"></span>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-main)]">
            India Post Article Identification Matrix
          </h2>
        </div>
        <span class="font-mono text-[11px] text-[var(--text-subtle)]">UPU S10 Standard</span>
      </div>

      <div class="overflow-x-auto rounded-xl border border-[var(--border)] bg-[var(--bg-card)]">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-[var(--bg-page)] border-b border-[var(--border)] text-[var(--text-muted)]">
            <tr>
              <th class="py-3 px-4 font-semibold">Prefix</th>
              <th class="py-3 px-4 font-semibold">Service Type</th>
              <th class="py-3 px-4 font-semibold">Handling Network</th>
              <th class="py-3 px-4 font-semibold">Expected Transit SLA</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border)] text-[var(--text-main)]">
            <tr class="hover:bg-[var(--bg-page)] transition-colors">
              <td class="py-3 px-4 text-red-500 dark:text-red-400 font-bold">EM / EK / ED</td>
              <td class="py-3 px-4">Speed Post (Domestic Express)</td>
              <td class="py-3 px-4 text-[var(--text-muted)]">National Sorting Hub (NSH) Air Corridors</td>
              <td class="py-3 px-4 text-emerald-500 dark:text-emerald-400">1 – 3 Business Days</td>
            </tr>
            <tr class="hover:bg-[var(--bg-page)] transition-colors">
              <td class="py-3 px-4 text-blue-500 dark:text-blue-400 font-bold">CX / CP</td>
              <td class="py-3 px-4">Domestic Air / Surface Parcel</td>
              <td class="py-3 px-4 text-[var(--text-muted)]">Parcel Sorting Hub (PSH) + Rail Transit</td>
              <td class="py-3 px-4 text-[var(--text-muted)]">3 – 6 Business Days</td>
            </tr>
            <tr class="hover:bg-[var(--bg-page)] transition-colors">
              <td class="py-3 px-4 text-amber-500 dark:text-amber-400 font-bold">RT / RN</td>
              <td class="py-3 px-4">Registered Letter & Legal Notice</td>
              <td class="py-3 px-4 text-[var(--text-muted)]">Railway Mail Service (RMS) Section</td>
              <td class="py-3 px-4 text-[var(--text-muted)]">3 – 7 Business Days</td>
            </tr>
            <tr class="hover:bg-[var(--bg-page)] transition-colors">
              <td class="py-3 px-4 text-emerald-500 dark:text-emerald-400 font-bold">JA / JJ</td>
              <td class="py-3 px-4">Insured Postal Consignment</td>
              <td class="py-3 px-4 text-[var(--text-muted)]">High-Security Vault & Direct Dispatch</td>
              <td class="py-3 px-4 text-emerald-500 dark:text-emerald-400">2 – 4 Business Days</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Frequently Asked Questions -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-red-500"></span>
          <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-main)]">
            Frequently Asked Questions
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5 space-y-2">
          <h4 class="text-sm font-bold text-[var(--text-main)] font-heading">How often is tracking telemetry refreshed?</h4>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Consignment queries are fetched live directly against the national postal dispatch network. Each query executes in real time without stale intermediary caching.
          </p>
        </div>
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5 space-y-2">
          <h4 class="text-sm font-bold text-[var(--text-main)] font-heading">What is the benefit of the Compacted Audit Trail?</h4>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Standard India Post scans record every internal bag opening, closing, and handover across RMS centers (often 30+ repetitive rows). We consolidate these into high-signal hub milestones, while preserving the raw scan toggle.
          </p>
        </div>
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5 space-y-2">
          <h4 class="text-sm font-bold text-[var(--text-main)] font-heading">Are consignment numbers stored on your servers?</h4>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            No. Recent searches are stored exclusively in your local browser’s localStorage. DakPulse maintains zero database of user lookups.
          </p>
        </div>
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5 space-y-2">
          <h4 class="text-sm font-bold text-[var(--text-main)] font-heading">Can I integrate DakPulse into my ecommerce storefront?</h4>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Yes. DakPulse provides an open `/api/track` JSON endpoint and clean modular TypeScript architecture that can be embedded into any web admin or storefront.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
