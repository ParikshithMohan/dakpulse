---
import Layout from '../layouts/Layout.astro';
import ConsignmentTracker from '../components/ConsignmentTracker.astro';
import { getTrackingDetails, sanitizeConsignmentNumber } from '../lib/tracking-engine';

export const prerender = false;

const rawConsignment = Astro.url.searchParams.get('consignment') ?? '';
const sanitized = rawConsignment ? sanitizeConsignmentNumber(rawConsignment) : '';
const initialData = sanitized ? await getTrackingDetails(sanitized) : null;
---

<Layout
  title={
    initialData
      ? `${initialData.consignmentNumber} (${initialData.statusLabel}) | DakPulse`
      : 'DakPulse – India Post Tracking & Delivery Calculator'
  }
  description="Fast, ad-free India Post Speed Post and parcel tracking, real-time routing map, and instant postage rate calculator."
>
  <ConsignmentTracker initialData={initialData} initialAwb={sanitized} />
</Layout>
